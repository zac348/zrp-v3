---
import Layout from '../layouts/Layout.astro';
import StatusMessage from '../components/StatusMessage.astro';
import { BOOKING_OPEN } from '../config.js';
import '../styles/book.css';
---
<Layout title="Book a session — Zachary Routsong" redirectTo={BOOKING_OPEN ? undefined : '/#contact'}>
<div class="booking-page">
  <header id="booking-intro"><h1>Request a session</h1><p>Choose a package, any add-ons, and a preferred date. Zachary will review your request before you complete the session details.</p></header>
  <div id="booking-content">
    <section aria-labelledby="package-heading"><h2 class="step-heading" id="package-heading">1. Package</h2><div class="pkg-grid" id="pkg-grid"><StatusMessage>Loading packages…</StatusMessage></div></section>
    <div class="booking-columns"><form id="book-form"><h2 class="step-heading">2. Your details</h2><div class="hp-field" aria-hidden="true"><label for="f-website">Website</label><input type="text" id="f-website" name="website" tabindex="-1" autocomplete="off"/></div>
    <div class="form-grid">
      <div class="field"><label for="f-first">First name</label><input type="text" id="f-first" placeholder="Jordan" required/></div>
      <div class="field"><label for="f-last">Last name</label><input type="text"  id="f-last"  placeholder="Smith"  required/></div>
      <div class="field"><label for="f-email">Email</label><input type="email" id="f-email" placeholder="you@email.com" required/></div>
      <div class="field"><label for="f-phone">Phone</label><input type="tel" id="f-phone" placeholder="(229) 555-0100"/></div>

      <hr class="divider"/>

      <div class="field full">
        <h2 class="step-heading">3. Date and session</h2><span id="date-label">Session date</span>
        <input type="hidden" id="f-date"/>
        <div class="cal" role="group" aria-labelledby="date-label">
          <div class="cal-head">
            <button type="button" id="cal-prev" class="cal-nav" aria-label="Previous month">‹</button>
            <span class="cal-title" id="cal-title">—</span>
            <button type="button" id="cal-next" class="cal-nav" aria-label="Next month">›</button>
          </div>
          <div class="cal-dow"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
          <div class="cal-days" id="cal-days"></div>
          <div class="cal-legend">
            <span>open</span>
            <span>limited</span>
            <span class="lg-strike">15</span><span>booked</span>
          </div>
        </div>
        <p class="cal-picked" id="cal-picked" aria-live="polite"></p>
      </div>
      <div class="field">
        <label for="f-time">Start time</label>
        <input type="time" id="f-time"/>
      </div>
      <div class="field">
        <label for="f-sport">Session type</label>
        <select id="f-sport" required>
          <option value="" disabled selected>Select…</option>
          <option>Portraits</option><option>Family</option><option>Senior photos</option>
          <option>Couples / Engagement</option><option>Event</option><option>Sports</option>
          <option>Branding / Product</option><option>Other</option>
        </select>
      </div>

      <!-- per-session-type follow-up questions render here -->
      <div id="type-questions"></div>

      <hr class="divider"/>

      <div class="field full"><h2 class="step-heading">4. Add-ons and estimate</h2><span>Add-ons (optional)</span><div id="booking-addons">Loading add-ons…</div></div>
      <div class="field full">
        <div class="coupon-row">
          <label class="field" for="f-coupon">Promo code<input type="text" id="f-coupon" placeholder="Optional"/></label>
          <button type="button" class="btn" id="coupon-btn">Apply</button>
        </div>
        <div class="status" role="status" id="coupon-status"></div>
      </div>
      <!-- COST BOX -->
      <div class="cost-box">
        <div class="cost-label">Package estimate</div>
        <div id="cost-empty" class="cost-empty">Select a package above to see pricing.</div>
        <div id="cost-lines" hidden>
          <div class="cost-line"><span id="cl-pkg-n"></span><span id="cl-pkg-p"></span></div>
          <div class="cost-line" id="cl-coupon" hidden><span id="cl-coupon-n"></span><span id="cl-coupon-v"></span></div>
          <p id="cl-addons" class="cost-line"></p><div class="cost-line total"><span>Estimated total</span><span id="cl-total"></span></div>
          <div class="cost-line note"><span>Package and selected add-ons. Travel is quoted separately; Zachary confirms the final price.</span></div>
        </div>

      </div>

      <hr class="divider"/>

      <div class="field full">
        <label for="f-notes">Anything else? (optional)</label>
        <textarea id="f-notes" maxlength="1200" placeholder="Location ideas, who or what we're shooting, questions, etc."></textarea>
      </div>

      <div class="agree-row">
        <input type="checkbox" id="f-agree" required/>
        <label for="f-agree">I have read and agree to the <a href="/terms" target="_blank">Terms</a> and <a href="/privacy" target="_blank">Privacy Policy</a>. I confirm I am at least 13 years old, or I am a parent/guardian submitting this on behalf of a minor.</label>
      </div>
      <div class="agree-row">
        <input type="checkbox" id="f-portfolio"/>
        <label for="f-portfolio">Optional: it's OK to feature photos from my session in Zachary's portfolio and social media.</label>
      </div>

      <p id="booking-status" class="status error full" role="alert" tabindex="-1"></p>
      <button type="submit" class="submit-btn" id="submit-btn" disabled>Select a package to continue</button>
    </div>
    </form><aside class="estimate" aria-label="Current estimate"><p>Estimated total</p><strong id="estimate-value" aria-live="polite">Choose a package</strong><p>Travel quoted separately.</p></aside></div>
  </div>
  <section class="success-state" id="success-state" hidden tabindex="-1"><h2>Request sent!</h2><p>Your request is saved. Zachary will review it and contact you. After acceptance, you can complete the final session details.</p></section>
</div>
<script src="../lib/book.js"></script>
</Layout>
