---
import Base from '../layouts/Base.astro';
import site from '../lib/content.js';
const r = site.resume;
---
<Base title={`Resume — ${site.name}`}>
  <div class="page">
    <header class="page-head"><h1>Resume</h1>{r.summary && <p>{r.summary}</p>}
      <div class="actions no-print">
        <a class="btn" href="/resume-pdf?download">Download resume</a>
        {r.pdf && <a class="line-link" href={r.pdf} download>Original PDF</a>}
      </div>
    </header>
    {r.sections.map(s => <section class="block split"><h2>{s.heading}</h2>
      <ul class="r-items">{s.items.map(item => <li>
        <div class="r-row"><h3>{item.title}</h3>{item.meta && <span>{item.meta}</span>}</div>
        {item.points.length > 0 && <ul>{item.points.map(point => <li>{point}</li>)}</ul>}
      </li>)}</ul>
    </section>)}
  </div>
</Base>
