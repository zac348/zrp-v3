<!-- PRICING -->
  <div class="tab" id="tab-pricing">
    <h1 class="main-title">Pricing</h1>
    <p class="main-sub">Set prices, run sales, and toggle availability. Changes go live immediately.</p>
    <div class="sec-label">packages</div>
    <div id="pricing-list"><p class="no-data">Loading…</p></div>
    <div class="space-top sec-label">add-ons</div>
    <div id="addon-list"><p class="no-data">Loading…</p></div>
    <div class="actions space-top">
      <input type="text" id="new-addon-name" placeholder="New add-on (e.g. Second photographer)"/ class="grow">
      <input type="number" id="new-addon-price" placeholder="$" min="0"/>
      <button class="btn-sm on-ink" data-action="addAddon">Add</button>
      <button class="btn-sm" data-action="seedAddons">Add starter pack</button>
    </div>
    <p class="muted-note space-top">Available add-ons show up on the booking form automatically.</p>
  </div>
