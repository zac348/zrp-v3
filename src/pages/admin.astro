// ── UPLOAD ──
const dropZone = document.getElementById('drop-zone');
const fileInput = document.getElementById('file-input');

dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop', e => { e.preventDefault(); dropZone.classList.remove('dragover'); handleFiles(e.dataTransfer.files); });
fileInput.addEventListener('change', e => handleFiles(e.target.files));

async function handleFiles(files) {
  if (!files?.length) return;
  const sport   = document.getElementById('up-sport').value;
  const galId   = document.getElementById('up-gallery').value || null;
  const onHP    = document.getElementById('up-hp').checked;
  const progWrap = document.getElementById('prog-wrap');
  const progBar  = document.getElementById('prog-bar');
  const status   = document.getElementById('up-status');
  progWrap.style.display = 'block'; let done = 0;
  for (const file of files) {
    status.textContent = `Uploading ${file.name}…`;
    const fd = new FormData();
    fd.append('file', file);
    let key, url;
    try {
      const res  = await fetch('/api/upload', { method: 'POST', body: fd });
      const json = await res.json();
      if (json.error) { status.textContent = `Error: ${json.error}`; continue; }
      key = json.key; url = json.url;
    } catch (e) {
      status.textContent = `Upload error: ${e.message}`;
      continue;
    }
    await sb.from('portfolio_photos').insert({
      file_name: file.name, storage_path: key,
      url, sport: sport || null,
      gallery_id: galId, show_on_homepage: onHP,
      file_size: file.size,
    });
    done++;
    progBar.style.width = Math.round((done / files.length) * 100) + '%';
  }
  progWrap.style.display = 'none'; progBar.style.width = '0';
  status.textContent = `✓ ${done} photo(s) uploaded`;
  fileInput.value = '';
  await loadPhotos(); updateStats();
  toast(done + ' photo(s) uploaded');
}

