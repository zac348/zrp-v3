---
import '../styles/album.css';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Your Gallery — ZRP">


<div class="album-page" id="gallery-page">
  <div id="not-found" class="not-found" hidden>
    <h2>Gallery not found</h2>
    <p>This link may have expired or the gallery doesn't exist.</p>
  </div>

  <div id="gallery-content" hidden>
    <div class="gallery-header">
      <p class="gallery-tag">Private gallery</p>
      <h1 class="gallery-title" id="gallery-title">Loading…</h1>
      <p class="gallery-meta" id="gallery-meta"></p>
      <div class="watermark-notice" id="watermark-notice" hidden>
        These are preview photos. Final edited versions will be delivered shortly.
      </div>
      <button class="dl-all" id="dl-all-btn"  hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2"><polyline points="8 17 12 21 16 17"/><line x1="12" y1="3" x2="12" y2="21"/></svg>
        Download all
      </button>
    </div>

    <p id="gallery-status" role="status" aria-live="polite"></p>
    <div class="gallery-grid" id="gallery-grid"></div>
  </div>
</div>

<dialog class="lightbox" id="lb" aria-label="Client photograph viewer" >
  <button type="button" class="lb-close" aria-label="Close photograph viewer" >×</button>
  <div class="album-viewer-image">
    <img id="lb-img" width="2200" height="1467" alt=""/>
    <div id="lb-wm" hidden></div>
  </div>
  <button type="button" class="lb-dl" id="lb-dl">Download original</button>
</dialog>

<script>
import { createClient } from '@supabase/supabase-js';
const sb = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

let galleryPhotos = [], isWatermarked = false;
let activeIndex = 0, lastTrigger = null, previousOverflow = '';
const gallerySlug = new URLSearchParams(location.search).get('g');

async function loadGallery() {
  const slug = new URLSearchParams(window.location.search).get('g');
  if (!slug) { showNotFound(); return; }

  const { data: gallery, error: galErr } = await sb
    .from('client_galleries')
    .select('*')
    .eq('slug', slug)
    .single();

  if (galErr || !gallery) { showNotFound(); return; }

  document.getElementById('gallery-title').textContent = gallery.name;
  document.title = gallery.name + ' — ZRP';

  const { data: photos, error: photoError } = await sb
    .from('portfolio_photos')
    .select('*')
    .eq('gallery_id', gallery.id)
    .order('created_at', { ascending: true });

  if (photoError) {
    document.getElementById('not-found').querySelector('h2').textContent = 'Photographs are unavailable';
    document.getElementById('not-found').querySelector('p').textContent = 'Please try again in a moment, or contact Zachary.';
    showNotFound(); return;
  }
  galleryPhotos = photos || [];

  document.getElementById('gallery-meta').innerHTML =
    `<strong>${galleryPhotos.length}</strong> photo${galleryPhotos.length !== 1 ? 's' : ''}`;

  isWatermarked = !!gallery.watermarked;
  if (isWatermarked) {
    document.getElementById('watermark-notice').hidden = false;
  }

  if (galleryPhotos.length > 0) {
    document.getElementById('dl-all-btn').hidden = false;
  }

  renderGallery();
  document.getElementById('gallery-content').hidden = false;
}

function showNotFound() { document.getElementById('not-found').hidden = false; }

function renderGallery() {
  const grid = document.getElementById('gallery-grid');
  if (!galleryPhotos.length) {
    grid.innerHTML = '<p class="no-data" >No photos in this gallery yet.</p>';
    return;
  }
  grid.innerHTML = '';
  galleryPhotos.forEach((p, i) => {
    const el = document.createElement('div'); el.className = 'gal-item';
    const button = document.createElement('button'); button.type = 'button'; button.className = 'gal-open';
    button.setAttribute('aria-label', 'View ' + (p.title || p.file_name || 'photograph ' + (i + 1)));
    const img = document.createElement('img'); img.src = p.thumb_url || p.web_url || p.url; img.alt = p.title || ('Photograph ' + (i + 1)); img.loading = i < 3 ? 'eager' : 'lazy'; img.decoding = 'async';
    img.width = p.width || 700; img.height = p.height || 467;
    img.addEventListener('error',()=>{img.hidden=true;button.textContent='Preview unavailable. Open photograph';});
    button.append(img); button.addEventListener('click', () => openLB(i, button));
    const overlay = document.createElement('div'); overlay.className = 'gal-item-overlay';
    const download = document.createElement('button'); download.type = 'button'; download.className = 'dl-btn'; download.textContent = isWatermarked ? 'Download preview' : 'Download original';
    download.addEventListener('click', () => downloadPhoto(p.url, p.file_name)); overlay.append(download);
    el.append(button, overlay);
    if (isWatermarked) { const mark = document.createElement('div'); mark.className = 'wm-badge'; mark.textContent = 'Copyright – Zachary R.'; el.append(mark); }
    grid.append(el);
  });
}

function openLB(index, trigger) {
  activeIndex = (index + galleryPhotos.length) % galleryPhotos.length;
  const photo = galleryPhotos[activeIndex];
  const viewer = document.getElementById('lb');
  const image = document.getElementById('lb-img');
  image.width = photo.width || 2200; image.height = photo.height || 1467;
  image.src = photo.web_url || photo.url;
  image.alt = photo.title || ('Photograph ' + (activeIndex + 1));
  document.getElementById('lb-dl').textContent = isWatermarked ? 'Download preview' : 'Download original';
  
  if (!viewer.open) { lastTrigger = trigger || document.activeElement; previousOverflow = document.body.style.overflow; document.body.style.overflow = 'hidden'; }
  const wmDiv = document.getElementById('lb-wm');
  if (isWatermarked) {
    // Build tiled watermark grid matching the canvas pattern
    wmDiv.innerHTML = '';
    // 4 cols × 5 rows of staggered labels covers any crop
    const rows = 5, cols = 4;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const span = document.createElement('span');
    
        span.textContent = 'Copyright – Zachary R.';
        span.className = 'watermark-label';

        wmDiv.appendChild(span);
      }
    }
    wmDiv.hidden = false;
  } else {
    wmDiv.hidden = true;
  }

  viewer.classList.add('open');
  if (!viewer.open) viewer.showModal();
  viewer.querySelector('.lb-close').focus();
}

function closeLB(e) {
  if (e && e.target !== document.getElementById('lb') && e.target !== document.querySelector('.lb-close')) return;
  document.body.style.overflow = previousOverflow;
  document.getElementById('lb').close();
}

document.getElementById('lb').addEventListener('cancel', e => { e.preventDefault(); closeLB(); });
document.getElementById('lb').addEventListener('close', () => {
  document.getElementById('lb').classList.remove('open');
  document.body.style.overflow = previousOverflow;
  lastTrigger?.focus({ preventScroll: true });
});
document.getElementById('lb').addEventListener('keydown', e => {
  if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { e.preventDefault(); openLB(activeIndex + (e.key === 'ArrowLeft' ? -1 : 1)); }
});

const WM_TEXT = 'Copyright – Zachary R.';

function watermarkCanvas(img) {
  const W = img.naturalWidth;
  const H = img.naturalHeight;
  const canvas = document.createElement('canvas');
  canvas.width  = W;
  canvas.height = H;
  const ctx = canvas.getContext('2d');
  ctx.drawImage(img, 0, 0, W, H);

  const sz      = Math.max(16, Math.floor(Math.min(W, H) * 0.022));
  const gapX    = Math.floor(W * 0.32);   // horizontal repeat spacing
  const gapY    = Math.floor(H * 0.22);   // vertical repeat spacing
  const angle   = -25 * Math.PI / 180;    // diagonal tilt

  ctx.save();
  ctx.font        = 'bold ' + sz + 'px "Public Sans", sans-serif';
  ctx.lineWidth   = Math.max(2, sz * 0.16);
  ctx.lineJoin    = 'round';
  ctx.strokeStyle = 'rgba(0,0,0,0.55)';
  ctx.fillStyle   = 'rgba(255,255,255,0.45)';

  // Tile across the whole image at an angle
  for (let row = -1; row * gapY < H + gapY; row++) {
    for (let col = -1; col * gapX < W + gapX; col++) {
      const x = col * gapX + (row % 2 === 0 ? 0 : gapX / 2);
      const y = row * gapY;
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);
      ctx.textAlign    = 'center';
      ctx.textBaseline = 'middle';
      ctx.strokeText(WM_TEXT, 0, 0);
      ctx.fillText(WM_TEXT, 0, 0);
      ctx.restore();
    }
  }

  ctx.restore();
  return canvas;
}

function saveBlob(blob, filename) {
  const objectURL = URL.createObjectURL(blob);
  const link = document.createElement('a'); link.href = objectURL; link.download = filename || 'photograph.jpg';
  document.body.append(link); link.click(); link.remove();
  setTimeout(() => URL.revokeObjectURL(objectURL), 10000);
}
async function downloadPhoto(url, filename) {
  const photo = galleryPhotos.find(p => p.url === url);
  const status = document.getElementById('gallery-status');
  if (!photo) return false;
  status.textContent = 'Preparing your photograph…';
  try {
    // The same-origin endpoint verifies membership in this shared gallery and
    // streams the original from R2, avoiding cross-origin download restrictions.
    const endpoint = '/api/gallery-file?' + new URLSearchParams({ g: gallerySlug, photo: photo.id });
    const response = await fetch(endpoint, { signal: AbortSignal.timeout(60000) });
    if (!response.ok) throw new Error('Download unavailable');
    let blob = await response.blob();
    if (isWatermarked) {
      const objectURL = URL.createObjectURL(blob);
      try {
        const img = new Image(); img.src = objectURL; await img.decode();
        await document.fonts.load('600 16px "Public Sans"');
        const canvas = watermarkCanvas(img);
        blob = await new Promise((resolve, reject) => canvas.toBlob(b => b ? resolve(b) : reject(new Error('Could not create preview')), 'image/jpeg', .93));
      } finally { URL.revokeObjectURL(objectURL); }
    }
    saveBlob(blob, filename); status.textContent = 'Your photograph is ready.'; return true;
  } catch (_) {
    status.textContent = 'The download didn’t complete. Please try again, or contact Zachary.';
    return false;
  }
}

async function downloadAll() {
  const btn = document.getElementById('dl-all-btn'); if (btn.disabled) return;
  btn.disabled = true; let count = 0;
  try {
    for (const photo of galleryPhotos) {
      btn.textContent = `Preparing ${count + 1} of ${galleryPhotos.length}…`;
      if (!(await downloadPhoto(photo.url, photo.file_name))) break;
      count++;
    }
    if (count === galleryPhotos.length) document.getElementById('gallery-status').textContent = `${count} photographs prepared. Your browser may ask to allow multiple downloads.`;
  } finally { btn.disabled = false; btn.textContent = 'Download all'; }
}

document.getElementById('dl-all-btn').addEventListener('click',downloadAll);
document.getElementById('lb').addEventListener('click',closeLB);
document.querySelector('.lb-close').addEventListener('click',()=>closeLB());
document.getElementById('lb-dl').addEventListener('click',()=>{const p=galleryPhotos[activeIndex];if(p)downloadPhoto(p.url,p.file_name);});
loadGallery().catch(() => { showNotFound(); document.querySelector('#not-found p').textContent = 'The gallery could not load. Please try again in a moment.'; });
</script>
</Layout>
