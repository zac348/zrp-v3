---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/site.css';
import { PRIMARY_CTA } from '../config.js';
interface Props {
  title: string;
  description?: string;
  noNav?: boolean;
  noFooter?: boolean;
  redirectTo?: string;
  editorial?: boolean;
}
const { title, description = 'Zachary Routsong is a photographer in Valdosta, Georgia. Portraits, families, events, sports, and landscapes.', noNav = false, noFooter = false, redirectTo } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const publicPage = path === '/' || path === '/portfolio';
const authPage = path === '/login' || path === '/reset';
---
<!doctype html>
<html lang="en" class="zr-site" data-page={path.slice(1) || 'home'}>
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    {redirectTo && <meta http-equiv="refresh" content={`0; url=${redirectTo}`}/>}
    {(redirectTo || ['/admin','/login','/reset','/confirm','/invoice','/gallery','/client-details','/client-gallery','/coupon-card'].includes(path)) && <meta name="robots" content="noindex,nofollow"/>}
    {['/client-details','/client-gallery'].includes(path) && <meta name="referrer" content="no-referrer"/>}
    <title>{title}</title>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#eeeae3"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="preload" href="/fonts/bodoni-moda-400-normal.ttf" as="font" type="font/ttf" crossorigin/>
    <link rel="preload" href="/fonts/public-sans-400-normal.ttf" as="font" type="font/ttf" crossorigin/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Zachary Routsong Photography"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={`https://zrphotos.net${path === '/' ? '' : path}`}/>
    <meta property="og:image" content="https://zrphotos.net/og.png"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const system = window.matchMedia('(prefers-color-scheme: dark)');
        const normalize = value => value === 'light' || value === 'dark' ? value : 'system';
        let preference = 'system';
        try { preference = normalize(localStorage.getItem('zrp-theme')); } catch (_) {}
        const apply = () => {
          const dark = preference === 'dark' || (preference === 'system' && system.matches);
          root.classList.toggle('dark', dark);
          root.dataset.themePreference = preference;
          root.style.colorScheme = dark ? 'dark' : 'light';
          document.querySelector('meta[name="theme-color"]').content = dark ? '#191a18' : '#eeeae3';
          window.dispatchEvent(new Event('zrp-theme-change'));
        };
        window.zrpTheme = {
          set(value) {
            preference = normalize(value);
            try { localStorage.setItem('zrp-theme', preference); } catch (_) {}
            apply();
          }
        };
        system.addEventListener('change', apply);
        window.addEventListener('storage', event => {
          if (event.key === 'zrp-theme' || event.key === null) {
            try { preference = normalize(localStorage.getItem('zrp-theme')); } catch (_) {}
            apply();
          }
        });
        apply();
      })();
    </script>
  </head>
  <body class:list={{ 'public-page': publicPage, 'auth-page': authPage }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {!noNav && <header class="site-header">
      <a class="wordmark" href="/" aria-label="Zachary Routsong — home"><span class="monogram">zr.</span><span>Photography<br/>by Zachary Routsong</span></a>
      <span class="header-place">Valdosta, Georgia<br/><span>Portraits / Sport / Places</span></span>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/portfolio" aria-current={path === '/portfolio' ? 'page' : undefined}>Work</a>
        <a href="/#about">About</a>
        <a href={PRIMARY_CTA.href}>{PRIMARY_CTA.label === 'Get in touch' ? 'Contact' : PRIMARY_CTA.label}</a>
        <details class="theme-picker" id="theme-picker">
          <summary id="theme-toggle" aria-label="Appearance: System" title="Appearance: System"><svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor"/><path d="M10 3a7 7 0 0 1 0 14Z" fill="currentColor"/></svg></summary>
          <fieldset class="theme-options">
            <legend>Appearance</legend>
            <label><input type="radio" name="theme" value="system" checked/>System</label>
            <label><input type="radio" name="theme" value="light"/>Light</label>
            <label><input type="radio" name="theme" value="dark"/>Dark</label>
          </fieldset>
        </details>
      </nav>
    </header>}
    <main id="main-content" tabindex="-1"><slot/></main>
    {!noFooter && <footer class="site-footer">
      <div class="footer-top"><a href="/" class="footer-name">Zachary<br/><em>Routsong.</em></a><div class="footer-contact"><p>Valdosta, Georgia &amp; nearby</p><a href="mailto:zac@zrphotos.net">zac@zrphotos.net</a><a href="tel:+12293001006">229–300–1006</a></div><div class="footer-directory"><a href="/portfolio">Photographs</a><a href="/#about">About Zachary</a><a href={PRIMARY_CTA.href}>{PRIMARY_CTA.label}</a><a href="https://instagram.com/zacharyroutsongphotos" target="_blank" rel="noopener">Instagram <span aria-hidden="true">↗</span></a></div></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Zachary Routsong</span><span>All photographs by Zachary.</span><div><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/login">Studio login</a></div></div>
    </footer>}
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <div class="consent-bar" id="consent-bar"><span>We use your booking details to arrange your session. Read our <a href="/privacy">Privacy Policy</a>. You must be 13 or older, or a parent or guardian.</span><button type="button" id="dismiss-consent">Got it</button></div>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.getElementById('theme-toggle');
        const picker = document.getElementById('theme-picker');
        const choices = picker?.querySelectorAll('input[name="theme"]') || [];
        const syncTheme = () => {
          const preference = root.dataset.themePreference;
          const label = `Appearance: ${preference[0].toUpperCase()}${preference.slice(1)}`;
          toggle?.setAttribute('aria-label', label);
          toggle?.setAttribute('title', label);
          choices.forEach(choice => { choice.checked = choice.value === preference; });
        };
        syncTheme();
        window.addEventListener('zrp-theme-change', syncTheme);
        choices.forEach(choice => choice.addEventListener('change', () => window.zrpTheme.set(choice.value)));
        document.addEventListener('click', event => {
          if (picker?.open && !picker.contains(event.target)) picker.open = false;
        });
        picker?.addEventListener('keydown', event => {
          if (event.key === 'Escape') { picker.open = false; toggle.focus(); event.preventDefault(); }
        });
        picker?.addEventListener('focusout', event => {
          if (!picker.contains(event.relatedTarget)) picker.open = false;
        });
        const bar = document.getElementById('consent-bar');
        let accepted; try { accepted = localStorage.getItem('zrp-consent'); } catch (_) {}
        if (!accepted && /^\/(book|quick-book|confirm)\/?$/.test(location.pathname)) bar.classList.add('show');
        const dismiss = () => { bar.classList.remove('show'); try { localStorage.setItem('zrp-consent', '1'); } catch (_) {} };
        document.getElementById('dismiss-consent').addEventListener('click', dismiss);
        window.dismissConsent = dismiss;
      })();
    </script>
  </body>
</html>
