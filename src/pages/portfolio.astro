---
import Layout from '../layouts/Layout.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
---
<Layout title="The photographs — Zachary Routsong" description="Explore Zachary Routsong’s photographs of sports and places, with a filterable portfolio and full-size photo viewer.">
  <header class="archive-heading page-inset"><p class="tiny-label">The portfolio / Zachary Routsong</p><h1>The <em>photographs.</em></h1><div><p>Sports and landscape photography.</p><span id="port-total" class="tiny-label">Loading the collection</span></div></header>
  <section class="archive-section page-inset" id="portfolio" aria-label="Photograph collection"><div class="archive-tools"><div class="category-filters" id="cat-tags" aria-label="Filter photographs"></div><span class="tiny-label">Select a photograph to view it</span></div><div class="archive-grid" id="portfolio-grid" aria-busy="true"><p class="collection-message">Loading photographs…</p></div><div class="collection-bottom"><p id="port-count" aria-live="polite"></p><button type="button" class="line-link" id="load-more" hidden>Show more photographs <span aria-hidden="true">↓</span></button></div></section>
  <section class="archive-contact page-inset"><p class="tiny-label">Portraits, families, events &amp; sports</p><a href="/#contact">Contact <em>Zachary.</em><span aria-hidden="true">↗</span></a></section>
  <noscript><p class="no-script">Enable JavaScript to load the photographs, or <a href="https://instagram.com/zacharyroutsongphotos">see Zachary’s work on Instagram</a>.</p></noscript>
  <PhotoViewer/>
  <script src="../lib/archive.js"></script>
</Layout>
