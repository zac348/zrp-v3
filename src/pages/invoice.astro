---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Invoice — ZRP">
<style is:global>
.inv-page { max-width: 640px; margin: 0 auto; padding: 48px 24px 80px }

.inv-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40px;
  flex-wrap: wrap;
  gap: 16px;
}
.inv-logo {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--text-3);
}
.inv-ztn {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: .08em;
  color: var(--text-2);
}

.inv-from {
  margin-bottom: 32px;
}
.inv-from-label {
  font-family: 'DM Mono', monospace;
  font-size: 8px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--text-3);
  margin-bottom: 6px;
}
.inv-name { font-size: 18px; font-weight: 300; letter-spacing: -.02em; margin-bottom: 2px }
.inv-email { font-size: 12px; color: var(--text-3) }

.inv-meta {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 32px;
}
.inv-meta-cell { background: var(--surface); padding: 14px 16px }
.inv-meta-label {
  font-family: 'DM Mono', monospace;
  font-size: 8px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--text-3);
  margin-bottom: 4px;
}
.inv-meta-val { font-size: 12px; color: var(--text-2) }

.inv-items {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 16px;
}
.inv-item-header {
  display: grid;
  grid-template-columns: 1fr auto;
  padding: 10px 16px;
  background: var(--surface-dim);
  border-bottom: 1px solid var(--border);
}
.inv-item-header span {
  font-family: 'DM Mono', monospace;
  font-size: 8px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--text-3);
}
.inv-row {
  display: grid;
  grid-template-columns: 1fr auto;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  align-items: center;
  gap: 16px;
}
.inv-row:last-child { border-bottom: none }
.inv-row-name { font-size: 13px; color: var(--text-2) }
.inv-row-price { font-family: 'DM Mono', monospace; font-size: 12px; color: var(--text-2) }

.inv-totals {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 32px;
}
.inv-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 11px 16px;
  border-bottom: 1px solid var(--border);
  font-size: 12px;
  color: var(--text-2);
  gap: 16px;
}
.inv-total-row:last-child { border-bottom: none }
.inv-total-row.big { font-size: 14px; font-weight: 500; color: var(--text); background: var(--surface-dim) }
.inv-total-row.green { color: var(--green) }

.inv-print-btn {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-2);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 8px 16px;
  cursor: pointer;
  transition: all .15s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.inv-print-btn:hover { border-color: var(--border-2); color: var(--text) }

.not-found { text-align: center; padding: 80px 24px }
.not-found h2 { font-size: 20px; font-weight: 300; margin-bottom: 8px }
.not-found p { font-size: 13px; color: var(--text-3) }

@media print {
  .inv-print-btn, nav, footer { display: none !important }
  .inv-page { padding: 0 }
  body { background: #fff !important }
}
</style>

<div class="inv-page" id="inv-page">
  <div id="loading-state" style="text-align:center;padding:80px 24px">
    <p style="font-size:13px;color:var(--text-3)">Loading invoice…</p>
  </div>
  <div class="not-found" id="not-found" style="display:none">
    <h2>Invoice not found</h2>
    <p>Check the booking number and try again.</p>
  </div>
  <div id="inv-content" style="display:none">
    <div class="inv-header">
      <div>
        <div class="inv-logo">Zachary Routsong Photography</div>
        <div style="font-size:20px;font-weight:300;letter-spacing:-.02em;margin-top:4px">Invoice</div>
      </div>
      <div style="text-align:right">
        <div class="inv-ztn" id="inv-ztn-display"></div>
        <div style="font-size:11px;color:var(--text-3);margin-top:3px" id="inv-date-display"></div>
      </div>
    </div>

    <div class="inv-from">
      <div class="inv-from-label">Billed to</div>
      <div class="inv-name" id="inv-client-name"></div>
      <div class="inv-email" id="inv-client-email"></div>
    </div>

    <div class="inv-meta" id="inv-meta"></div>

    <div class="inv-items">
      <div class="inv-item-header"><span>Description</span><span>Amount</span></div>
      <div id="inv-line-items"></div>
    </div>

    <div class="inv-totals" id="inv-totals"></div>

    <button class="inv-print-btn" onclick="window.print()">
      <svg width="12" height="12" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Print / Save PDF
    </button>
  </div>
</div>

<script>
import { createClient } from '@supabase/supabase-js';
const sb = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

async function loadInvoice() {
  const params = new URLSearchParams(window.location.search);
  const ztn   = params.get('ztn');
  const token = params.get('token');

  if (!ztn && !token) { showNotFound(); return; }

  let query = sb.from('bookings').select('*');
  if (ztn)   query = query.eq('ztn_number', ztn);
  else       query = query.eq('token', token);

  const { data, error } = await query.single();

  document.getElementById('loading-state').style.display = 'none';
  if (error || !data) { showNotFound(); return; }

  const b = data;
  const name = [b.first_name, b.last_name].filter(Boolean).join(' ') || '—';

  // Header
  document.getElementById('inv-ztn-display').textContent = b.ztn_number || b.booking_number || '—';
  document.getElementById('inv-date-display').textContent = b.confirmed_at
    ? new Date(b.confirmed_at).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' })
    : b.created_at ? new Date(b.created_at).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }) : '';
  document.title = 'Invoice ' + (b.ztn_number || '') + ' — ZRP';

  // Client
  document.getElementById('inv-client-name').textContent  = name;
  document.getElementById('inv-client-email').textContent = b.email || '';

  // Meta cells
  const meta = document.getElementById('inv-meta');
  const metaItems = [
    b.event_date    && ['Event date',  b.event_date],
    b.event_time    && ['Start time',  b.event_time],
    b.sport_type    && ['Sport',       b.sport_type],
    (b.venue_address || b.event_location) && ['Venue', b.venue_address || b.event_location],
  ].filter(Boolean);
  meta.innerHTML = metaItems.map(([k, v]) =>
    `<div class="inv-meta-cell"><div class="inv-meta-label">${k}</div><div class="inv-meta-val">${v}</div></div>`
  ).join('');

  // Line items
  const lineItems = [];
  if (b.package_selected) {
    const parts = b.package_selected.split('—');
    const pkgName = parts[0]?.trim() || b.package_selected;
    const pkgPrice = parseFloat((parts[1] || '').replace('$', '').trim()) || 0;
    lineItems.push({ name: pkgName + ' package', price: pkgPrice });
  }
  if (b.addons_selected) {
    b.addons_selected.split(', ').forEach(a => {
      const match = a.match(/(.+)\s\+\$([0-9.]+)/);
      if (match) lineItems.push({ name: match[1].trim(), price: parseFloat(match[2]) });
    });
  }

  const linesEl = document.getElementById('inv-line-items');
  linesEl.innerHTML = lineItems.map(({ name, price }) =>
    `<div class="inv-row"><span class="inv-row-name">${name}</span><span class="inv-row-price">$${price.toFixed(2)}</span></div>`
  ).join('') || '<div class="inv-row"><span class="inv-row-name">—</span><span class="inv-row-price">—</span></div>';

  // Totals
  const total   = parseFloat((b.total   || '$0').replace('$', '')) || 0;
  const deposit = parseFloat((b.deposit || '$0').replace('$', '')) || 0;
  const balance = total - deposit;

  const totalsEl = document.getElementById('inv-totals');
  totalsEl.innerHTML = `
    <div class="inv-total-row big"><span>Total</span><span>$${total.toFixed(2)}</span></div>
    <div class="inv-total-row"><span>Deposit (50%)</span><span>$${deposit.toFixed(2)}</span></div>
    <div class="inv-total-row${balance <= 0 ? ' green' : ''}"><span>Balance due day of event</span><span>${balance <= 0 ? 'Paid' : '$' + balance.toFixed(2)}</span></div>
  `;

  document.getElementById('inv-content').style.display = 'block';
}

function showNotFound() {
  document.getElementById('loading-state').style.display = 'none';
  document.getElementById('not-found').style.display = 'block';
}

loadInvoice();
</script>
</Layout>
