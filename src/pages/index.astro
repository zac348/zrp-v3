---
import Layout from '../layouts/Layout.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
import { PRIMARY_CTA } from '../config.js';
const equipment = [
  ['Sony A7 III', 'Full-frame camera'], ['Tamron 28–75mm f/2.8', 'Portraits, families & events'],
  ['Sony 55–210mm', 'Sports & distance'], ['DJI Mini 3', 'Aerial photographs'],
  ['DJI Mic Mini', 'Wireless audio'], ['Insta360', 'Action & behind the scenes'], ['Meta Ray-Bans', 'Behind-the-scenes video'],
];
---
<Layout title="Zachary Routsong — Photography, Valdosta GA">
  <header class="masthead">
    <div class="masthead-meta"><span>Independent photographer</span><span>Valdosta, Georgia</span></div>
    <h1>Zachary <em>Routsong</em></h1>
    <div class="masthead-bottom"><span>Portraits / Families / Events / Sports</span><a href="#portfolio">Selected photographs <span aria-hidden="true">↓</span></a></div>
  </header>

  <section class="cover" aria-label="Featured photographs" aria-roledescription="carousel">
    <div class="cover-stage" aria-busy="true">
      <button type="button" id="cover-open" aria-label="Open featured photograph" disabled>
        <img id="cover-image" alt="" width="2200" height="1238" fetchpriority="high" hidden/>
        <span class="photo-loading" id="cover-loading">Loading photographs</span>
      </button>
    </div>
    <div class="cover-caption">
      <div class="cover-location"><span class="tiny-label">From the portfolio</span><p id="cover-title" aria-live="polite">A photograph by Zachary Routsong</p></div>
      <div class="cover-controls"><span id="cover-count">— / —</span><button type="button" id="cover-prev" aria-label="Previous featured photograph" disabled>←</button><button type="button" id="cover-next" aria-label="Next featured photograph" disabled>→</button></div>
    </div>
  </section>

  <section id="portfolio" class="selected-work page-inset" aria-labelledby="work-heading">
    <div class="section-heading"><div><p class="tiny-label">01 / The photographs</p><h2 id="work-heading">Selected <em>work.</em></h2></div><div class="category-filters" id="cat-tags" aria-label="Filter photographs"></div></div>
    <div class="selected-grid" id="portfolio-grid" aria-busy="true"><p class="collection-message">Loading the portfolio…</p></div>
    <div class="collection-bottom"><p id="port-count" aria-live="polite"></p><a class="line-link" href="/portfolio" id="port-link">The complete portfolio <span aria-hidden="true">↗</span></a></div>
  </section>

  <section id="about" class="about-section page-inset" aria-labelledby="about-heading">
    <div class="about-heading"><p class="tiny-label">02 / The photographer</p><h2 id="about-heading">About<br/><em>Zachary.</em></h2></div>
    <figure class="about-portrait"><img src="/zachary-800.jpg" srcset="/zachary-800.jpg 800w, /zachary.jpg 3240w" sizes="(max-width:700px) 90vw, 40vw" alt="Zachary at home in Valdosta" width="3240" height="2160" loading="lazy"/><figcaption><span>Zachary Routsong</span><span>Valdosta, GA</span></figcaption></figure>
    <div class="about-copy"><p>I’m based in Valdosta, Georgia. I photograph portraits, families, events, and sports in the area.</p><p>Sessions include edited photographs delivered through a private download gallery, typically within 5–7 days.</p><dl class="session-facts"><div><dt>Where I work</dt><dd>Valdosta &amp; nearby</dd></div><div><dt>Edited photographs</dt><dd>25+ per session</dd></div><div><dt>Sessions</dt><dd id="starting-price">Ask for pricing</dd></div></dl><a class="line-link" href={PRIMARY_CTA.href}>{PRIMARY_CTA.label} <span aria-hidden="true">↗</span></a></div>
    <details class="equipment"><summary>Equipment <span aria-hidden="true">+</span></summary><dl>{equipment.map(([name,use])=><div><dt>{name}</dt><dd>{use}</dd></div>)}</dl></details>
  </section>

  <section id="contact" class="contact-section page-inset" aria-labelledby="contact-heading">
    <div class="contact-heading"><p class="tiny-label">03 / Enquiries</p><h2 id="contact-heading">Contact</h2><p>For availability and pricing, send your session type, location, and preferred date. Text is the quickest way to reach me.</p><a class="contact-number" href="sms:+12293001006">229–300–1006 <span aria-hidden="true">↗</span></a><div class="contact-other"><a href="mailto:zac@zrphotos.net">Email Zachary</a><a href="https://ig.me/m/zacharyroutsongphotos" target="_blank" rel="noopener">Instagram</a></div><p class="contact-local">Sessions in Valdosta and the surrounding area.</p></div>
    <form id="contact-form" class="contact-form">
      <div class="hp-field" aria-hidden="true"><label for="c-website">Website</label><input type="text" id="c-website" name="website" tabindex="-1" autocomplete="off"/></div>
      <div class="field"><label for="c-name">Your name <span>(required)</span></label><input type="text" id="c-name" name="name" autocomplete="name" required maxlength="100"/></div>
      <div class="field"><label for="c-contact">Email or phone <span>(required)</span></label><input type="text" id="c-contact" name="contact" required maxlength="200"/></div>
      <div class="field field-full"><label for="c-message">Session details <span>(required)</span></label><textarea id="c-message" name="message" rows="3" required maxlength="3000" placeholder="Session type and location"></textarea></div>
      <div class="field field-full"><label for="c-date">Preferred date (optional)</label><input type="text" id="c-date" name="date" maxlength="100" placeholder="Date or month"/></div>
      <div class="agree-row"><input type="checkbox" id="c-local" required/><label for="c-local">My session is in Valdosta or nearby.</label></div>
      <div class="agree-row"><input type="checkbox" id="c-agree" required/><label for="c-agree">I agree to the <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a> and I’m 13 or older, or a parent or guardian.</label></div>
      <button type="submit" class="send-button" id="c-submit"><span>Send enquiry</span><span aria-hidden="true">↗</span></button>
      <p class="contact-status" id="c-status" role="status" aria-live="polite"></p>
    </form>
  </section>
  <noscript><p class="no-script">Enable JavaScript to browse the photographs and use the form. You can also <a href="sms:+12293001006">text Zachary</a> or <a href="mailto:zac@zrphotos.net">send an email</a>.</p></noscript>
  <PhotoViewer/>
  <script src="../lib/home.js"></script>
</Layout>
