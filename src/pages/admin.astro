<script>
import { createClient } from '@supabase/supabase-js';
const sb = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

// ── AUTH ──
sb.auth.getSession().then(({ data }) => {
  if (!data.session) window.location.href = '/login';
  else loadAll();
});

async function doLogout() { await sb.auth.signOut(); window.location.href = '/login'; }
window.doLogout = doLogout;

function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

// ── TABS ──
function switchTab(name, btn) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.sb-link').forEach(l => l.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  if (btn) btn.classList.add('active');
  if (name === 'calendar') renderCalendar();
  if (name === 'envelope') setTimeout(renderEnv, 50);
}
window.switchTab = switchTab;

// ── STATE ──
let allPhotos = [], allGalleries = [], allBookings = [], allBlocks = [], allCoupons = [];

async function loadAll() {
  await Promise.all([loadPhotos(), loadGalleries(), loadBookings(), loadBlocks(), loadCoupons(), loadPricing()]);
  updateStats();
}

function updateStats() {
  document.getElementById('st-photos').textContent   = allPhotos.length;
  document.getElementById('st-galleries').textContent = allGalleries.length;
  document.getElementById('st-bookings').textContent  = allBookings.length;
  document.getElementById('st-pending').textContent   = allBookings.filter(b => b.status === 'pending').length;
  loadStorageUsage();
}

function fmtBytes(bytes) {
  if (bytes < 1024)           return bytes + ' B';
  if (bytes < 1024*1024)      return (bytes/1024).toFixed(1) + ' KB';
  if (bytes < 1024*1024*1024) return (bytes/(1024*1024)).toFixed(1) + ' MB';
  return (bytes/(1024*1024*1024)).toFixed(2) + ' GB';
}

async function loadStorageUsage() {
  try {
    // Pull file_size for all photos from the database
    const { data: photos } = await sb.from('portfolio_photos').select('url, file_size');
    if (!photos) return;

    const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL;

    let r2Bytes = 0, sbBytes = 0;
    for (const p of photos) {
      const size = p.file_size || 0;
      if (p.url && p.url.startsWith(sbUrl)) {
        sbBytes += size;
      } else {
        r2Bytes += size;
      }
    }

    // R2 bar (5 TB cap)
    const r2Cap = 5 * 1024 * 1024 * 1024 * 1024;
    const r2Pct = Math.min((r2Bytes / r2Cap) * 100, 100);
    document.getElementById('r2-detail').textContent = fmtBytes(r2Bytes);
    document.getElementById('r2-fill').style.width = r2Pct.toFixed(2) + '%';

    // Supabase bar (1 GB cap)
    const sbCap = 1024 * 1024 * 1024;
    const sbPct = Math.min((sbBytes / sbCap) * 100, 100);
    document.getElementById('sb-detail').textContent = fmtBytes(sbBytes);
    document.getElementById('sb-fill').style.width = sbPct.toFixed(1) + '%';
    document.getElementById('storage-warn').style.display = sbPct > 70 ? 'block' : 'none';

    // Total for the stat tile
    document.getElementById('st-storage').textContent = fmtBytes(r2Bytes + sbBytes);
    document.getElementById('storage-bar-card').style.display = 'block';
  } catch(e) {
    document.getElementById('st-storage').textContent = '—';
  }
}

// ── PHOTOS ──
let selectedPhotoIds = new Set();
const PHOTOS_PER_PAGE = 24;
let photoPage = 0;

async function loadPhotos() {
  const { data } = await sb.from('portfolio_photos').select('*').order('created_at', { ascending: false });
  allPhotos = data || [];
  renderPhotos();
  populateGalDropdowns();
  renderGalleries(); // keep gallery photo counts in sync
}

function renderPhotos() {
  const g = document.getElementById('photos-grid');
  if (!allPhotos.length) { g.innerHTML = '<p class="no-data">No photos yet.</p>'; updateBulkBar(); return; }
  const start = photoPage * PHOTOS_PER_PAGE;
  const page  = allPhotos.slice(start, start + PHOTOS_PER_PAGE);
  g.innerHTML = page.map(p => `
    <div class="photo-card ${selectedPhotoIds.has(p.id) ? 'selected' : ''}" id="pc-${p.id}">
      <div class="photo-cb-wrap">
        <input type="checkbox" class="photo-cb" ${selectedPhotoIds.has(p.id) ? 'checked' : ''}
          onchange="togglePhotoSelect('${p.id}',this.checked)" onclick="event.stopPropagation()"/>
      </div>
      <img src="${p.url}" alt="" loading="lazy"
        onclick="togglePhotoSelect('${p.id}',!selectedPhotoIds.has('${p.id}'))" style="cursor:pointer"/>
      <div class="photo-card-info">
        <div class="photo-sport">${p.sport || 'No category'}</div>
        <div class="photo-name">${p.file_name}</div>
      </div>
      <div class="photo-actions">
        <button class="btn-sm ${p.show_on_homepage ? 'on-ink' : ''}" onclick="togHP('${p.id}',${p.show_on_homepage})">
          ${p.show_on_homepage ? 'On HP' : '+ HP'}
        </button>
        <button class="btn-sm red" onclick="delPhoto('${p.id}','${p.storage_path}')">Del</button>
      </div>
    </div>`).join('');
  updateBulkBar();
  renderPhotoPager();
}

function renderPhotoPager() {
  let pager = document.getElementById('photo-pager');
  const totalPages = Math.ceil(allPhotos.length / PHOTOS_PER_PAGE);
  if (!pager) {
    pager = document.createElement('div');
    pager.id = 'photo-pager';
    pager.style.cssText = 'display:flex;align-items:center;justify-content:space-between;margin-top:12px;gap:8px';
    document.getElementById('photos-grid').after(pager);
  }
  if (totalPages <= 1) { pager.innerHTML = ''; return; }
  pager.innerHTML = `
    <span style="font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.08em;color:var(--text-3)">
      ${photoPage*PHOTOS_PER_PAGE+1}–${Math.min((photoPage+1)*PHOTOS_PER_PAGE, allPhotos.length)} of ${allPhotos.length}
    </span>
    <div style="display:flex;gap:6px">
      <button class="btn-sm" onclick="setPhotoPage(${photoPage-1})" ${photoPage===0?'disabled style="opacity:.3"':''}>← Prev</button>
      <button class="btn-sm" onclick="setPhotoPage(${photoPage+1})" ${photoPage>=totalPages-1?'disabled style="opacity:.3"':''}>Next →</button>
    </div>`;
}
function setPhotoPage(p) { photoPage=p; renderPhotos(); document.getElementById('tab-upload').scrollIntoView({behavior:'smooth',block:'start'}); }
window.setPhotoPage = setPhotoPage;

function togglePhotoSelect(id, checked) {
  if (checked) selectedPhotoIds.add(id); else selectedPhotoIds.delete(id);
  const card = document.getElementById('pc-'+id);
  if (card) { card.classList.toggle('selected', checked); const cb=card.querySelector('.photo-cb'); if(cb) cb.checked=checked; }
  updateBulkBar();
}
window.togglePhotoSelect = togglePhotoSelect;

function toggleSelectAll(checked) { allPhotos.forEach(p => togglePhotoSelect(p.id, checked)); }
window.toggleSelectAll = toggleSelectAll;

function updateBulkBar() {
  const count = selectedPhotoIds.size;
  document.getElementById('bulk-count').textContent = count + ' selected';
  document.getElementById('bulk-actions').style.display = count > 0 ? 'flex' : 'none';
  const allCb = document.getElementById('select-all-cb');
  if (allCb) allCb.checked = count > 0 && count === allPhotos.length;
}

function populateGalDropdowns() {
  ['up-gallery','bulk-gallery'].forEach(id => {
    const sel = document.getElementById(id);
    if (!sel) return;
    const first = sel.options[0];
    sel.innerHTML = '';
    sel.appendChild(first);
    allGalleries.forEach(g => {
      const o = document.createElement('option'); o.value=g.id; o.textContent=g.name; sel.appendChild(o);
    });
  });
}

async function togHP(id, current) {
  const { error } = await sb.from('portfolio_photos').update({ show_on_homepage: !current }).eq('id', id);
  if (!error) { await loadPhotos(); toast(!current ? 'Added to homepage' : 'Removed from homepage'); }
}
window.togHP = togHP;

async function delPhoto(id, storagePath) {
  if (!confirm('Delete this photo? This cannot be undone.')) return;
  if (storagePath) {
    await fetch('/api/delete-photo', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key: storagePath }),
    });
  }
  await sb.from('portfolio_photos').delete().eq('id', id);
  selectedPhotoIds.delete(id);
  await loadPhotos();
  toast('Photo deleted');
}
window.delPhoto = delPhoto;

async function bulkChangeSport() {
  const sport = document.getElementById('bulk-sport').value;
  if (!sport || !selectedPhotoIds.size) return;
  await sb.from('portfolio_photos').update({ sport }).in('id', [...selectedPhotoIds]);
  await loadPhotos(); toast('Category updated');
}
window.bulkChangeSport = bulkChangeSport;

async function bulkAddToGallery() {
