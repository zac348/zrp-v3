---
import '../styles/admin-dialog.css';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/admin/Navigation.astro';
import '../styles/admin.css';
import '../styles/delivery.css';
import Overview from '../components/admin/Overview.astro';
import Photos from '../components/admin/Photos.astro';
import Galleries from '../components/admin/Galleries.astro';
import Bookings from '../components/admin/Bookings.astro';
import Availability from '../components/admin/Availability.astro';
import Pricing from '../components/admin/Pricing.astro';
import Coupons from '../components/admin/Coupons.astro';
import Print from '../components/admin/Print.astro';
---
<Layout title="Studio — Zachary Routsong" noNav={true} noFooter={true}>
  <div class="studio">
    <Navigation/>
    <div class="main">
      <Overview/>
      <Photos/>
      <Galleries/>
      <Bookings/>
      <Availability/>
      <Pricing/>
      <Coupons/>
      <Print/>
    </div>
  </div>
  <script src="../lib/admin/index.js"></script>
</Layout>
