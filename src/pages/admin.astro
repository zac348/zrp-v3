function bookingCard(b) {
  const name   = [b.first_name, b.last_name].filter(Boolean).join(' ') || 'Unknown';
  const status = b.status || 'pending';
  const numDisplay = b.ztn_number || b.booking_number || b.id?.slice(-8).toUpperCase() || '—';
  const venue = b.venue_address || b.event_location || '—';

  return `<div class="booking-card">
    <div class="booking-head">
      <div>
        <div class="booking-name">${name}</div>
        <div class="booking-num">${numDisplay}</div>
      </div>
      <div class="booking-badges">
        <span class="badge ${status}">${status}</span>
        ${b.package_selected ? `<span class="badge pkg">${b.package_selected.split('—')[0].trim()}</span>` : ''}
      </div>
    </div>
    <div class="booking-details">
      <div class="booking-detail"><strong>Date</strong>${b.event_date || '—'}</div>
      <div class="booking-detail"><strong>Time</strong>${b.event_time || '—'}</div>
      <div class="booking-detail"><strong>Session</strong>${b.sport_type || '—'}</div>
      <div class="booking-detail"><strong>Venue</strong>${venue}</div>
      <div class="booking-detail"><strong>Total</strong>${b.total || '—'}</div>
      <div class="booking-detail"><strong>Deposit</strong>${b.deposit || '—'}</div>
      <div class="booking-detail"><strong>Email</strong>${b.email || '—'}</div>
      <div class="booking-detail"><strong>Phone</strong>${b.phone || '—'}</div>
      ${b.addons_selected ? `<div class="booking-detail" style="grid-column:1/-1"><strong>Add-ons</strong>${b.addons_selected}</div>` : ''}
      ${b.notes ? `<div class="booking-detail" style="grid-column:1/-1"><strong>Notes</strong>${b.notes}</div>` : ''}
      ${b.gallery_id ? `<div class="booking-detail" style="grid-column:1/-1"><strong>Gallery</strong><a href="/gallery?g=${b.ztn_number ? b.ztn_number.toLowerCase() : ''}" target="_blank" style="color:var(--text-2);text-decoration:underline">${b.ztn_number ? b.ztn_number.toLowerCase() : 'view gallery'}</a></div>` : ''}
    </div>
    <div class="booking-actions">
      ${status === 'pending'   ? `<button class="btn-sm green"  onclick="acceptBooking('${b.id}','${name.replace(/'/g,'\\\'')}')" title="Accept and email client with confirm link">Accept</button>` : ''}
      ${status === 'accepted'  ? `<button class="btn-sm on-ink" onclick="setStatus('${b.id}','confirmed')">Mark confirmed</button>` : ''}
      ${status === 'confirmed' ? `<button class="btn-sm on-ink" onclick="setStatus('${b.id}','delivered')">Mark delivered</button>` : ''}
      ${status !== 'cancelled' && status !== 'pending' ? `<button class="btn-sm" onclick="setStatus('${b.id}','delivered')">Mark delivered</button>` : ''}
      ${status !== 'cancelled' ? `<button class="btn-sm red"    onclick="setStatus('${b.id}','cancelled')">Cancel</button>` : ''}
      ${status !== 'pending'   ? `<button class="btn-sm"        onclick="setStatus('${b.id}','pending')">Reset</button>` : ''}
      ${b.ztn_number ? `<a class="btn-sm" href="/invoice?ztn=${b.ztn_number}" target="_blank">Invoice</a>` : ''}
      <button class="btn-sm" onclick="mailTo('${b.email}','${name.replace(/'/g,'\\\'')}')" title="Open email client">Email</button>
    </div>
  </div>`;
}

async function acceptBooking(id, name) {
  if (!confirm('Accept booking for ' + name + '?\n\nThis will update their status and email them a link to complete their booking.')) return;

  // Step 1: read booking
  const { data: booking, error: getErr } = await sb.from('bookings').select('*').eq('id', id).single();
  if (getErr || !booking) { toast('Could not read booking'); return; }

  // Step 2: update status
  const { error: upErr } = await sb.from('bookings').update({ status: 'accepted' }).eq('id', id);
  if (upErr) { toast('DB error: ' + upErr.message); return; }

  await loadBookings();
  toast('Accepted ✓');

  // Step 3: send email
  try {
    const res = await fetch('/api/accept-booking', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email:   booking.email,
        name:    [booking.first_name, booking.last_name].filter(Boolean).join(' '),
        token:   booking.id,
        booking: {
          event_date:       booking.event_date,
          sport_type:       booking.sport_type,
          package_selected: booking.package_selected,
          total:            booking.total,
        },
      }),
    });
    const d = await res.json();
    if (d.emailSent) toast('Email sent to ' + booking.email);
    else toast('Email not sent: ' + (d.debug || d.resendError || 'unknown'));
  } catch(e) {
    toast('Accepted — email failed: ' + e.message);
    console.error('Email error:', e);
  }
}
window.acceptBooking = acceptBooking;

