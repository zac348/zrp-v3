---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Book a Session — ZRP">
<style is:global>
.page { max-width: 560px; margin: 0 auto; padding: 48px 24px 80px }
@media (max-width: 480px) { .page { padding: 32px 16px 64px } }

/* PACKAGES */
.pkg-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 32px;
}
@media (max-width: 500px) { .pkg-grid { grid-template-columns: 1fr } }

.pkg-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 16px;
  cursor: pointer;
  transition: border-color .2s, background .2s, transform .25s cubic-bezier(.16,1,.3,1), box-shadow .25s;
  position: relative;
  opacity: 0;
  animation: rise-in .6s cubic-bezier(.16,1,.3,1) both;
  animation-delay: var(--d, 0s);
}
.pkg-card:hover { border-color: var(--border-2); transform: translateY(-3px); box-shadow: 0 8px 24px rgba(26,25,24,.08) }
.pkg-card.sel {
  border-color: var(--text);
  background: var(--surface-dim);
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(26,25,24,.1);
}
.pkg-card.unavail { opacity: .4; cursor: not-allowed; pointer-events: none }
.pkg-badge {
  font-family: 'DM Mono', monospace;
  font-size: 8px;
  letter-spacing: .1em;
  text-transform: uppercase;
  background: var(--text);
  color: var(--bg);
  padding: 2px 7px;
  position: absolute;
  top: -1px; right: 12px;
  transform: translateY(-50%);
}
.pkg-sale-badge {
  font-family: 'DM Mono', monospace;
  font-size: 8px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--red);
  background: var(--red-bg);
  border: 1px solid var(--red-border);
  padding: 2px 7px;
  display: inline-block;
  margin-bottom: 4px;
}
.pkg-name {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--text-3);
  margin-bottom: 6px;
}
.pkg-orig { font-size: 11px; color: var(--text-3); text-decoration: line-through; line-height: 1; margin-bottom: 1px }
.pkg-price { font-size: 26px; font-weight: 300; letter-spacing: -.02em; margin-bottom: 10px }
.pkg-price small { font-size: 12px; color: var(--text-3); font-weight: 400 }
.pkg-price.sale { color: var(--green) }
.pkg-features { list-style: none; display: flex; flex-direction: column; gap: 5px }
.pkg-features li { font-size: 11px; color: var(--text-2); display: flex; align-items: center; gap: 6px }
.pkg-features li::before { content: '—'; color: var(--text-3); font-size: 9px; flex-shrink: 0 }

/* FORM */
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px }
@media (max-width: 480px) { .form-grid { grid-template-columns: 1fr } }
.field.full { grid-column: 1/-1 }

/* AVAILABILITY CALENDAR */
.cal { border: 1px solid var(--border); padding: 14px; background: var(--surface) }
.cal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px }
.cal-title {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--text);
}
.cal-nav {
  background: none;
  border: 1px solid var(--border);
  width: 26px; height: 26px;
  cursor: pointer;
  color: var(--text-2);
  font-size: 13px;
  line-height: 1;
  transition: border-color .15s, color .15s;
}
.cal-nav:hover:not(:disabled) { border-color: var(--text); color: var(--text) }
.cal-nav:disabled { opacity: .3; cursor: default }
.cal-dow, .cal-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px }
.cal-dow span {
  font-family: 'DM Mono', monospace;
  font-size: 8px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--text-3);
  text-align: center;
  padding: 3px 0 6px;
}
.cal-d {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  color: var(--text-2);
  background: none;
  border: 1px solid transparent;
  cursor: pointer;
  position: relative;
  transition: border-color .15s, color .15s, background .15s;
}
.cal-d:hover:not(:disabled) { border-color: var(--border-2); color: var(--text) }
.cal-d:disabled { cursor: default; color: var(--text-3); opacity: .4 }
.cal-d.blocked { text-decoration: line-through }
.cal-d.sel { border-color: var(--accent); color: var(--text); background: var(--surface-dim) }
.cal-d.empty { visibility: hidden }
.cal-d .dot {
  position: absolute;
  bottom: 3px; left: 50%;
  transform: translateX(-50%);
  width: 3px; height: 3px;
  border-radius: 50%;
}
.cal-legend {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid var(--border);
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--text-3);
}
.cal-legend span { display: flex; align-items: center; gap: 5px }
.cal-legend i { width: 4px; height: 4px; border-radius: 50%; display: inline-block }
.lg-strike { text-decoration: line-through }
.cal-picked {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: .08em;
  color: var(--text-2);
  margin-top: 8px;
  min-height: 15px;
}
.cal-picked b { color: var(--accent); font-weight: 500 }

/* COST BOX */
.cost-box {
  grid-column: 1/-1;
  background: var(--surface-dim);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 16px;
}
.cost-label {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-3);
  margin-bottom: 10px;
}
.cost-line { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-2); padding: 2px 0 }
.cost-line.total { border-top: 1px solid var(--border); margin-top: 8px; padding-top: 9px; font-size: 13px; font-weight: 500; color: var(--text) }
.cost-line.note { font-size: 11px; color: var(--text-3); padding-top: 6px; font-style: italic }
.cost-empty { font-size: 12px; color: var(--text-3); font-style: italic }

/* SUBMIT */
.submit-btn {
  width: 100%; background: none; color: var(--text);
  border: 1px solid var(--text); padding: 14px;
  font-family: 'DM Mono', monospace; font-size: 11px; font-weight: 500;
  letter-spacing: .14em; text-transform: uppercase;
  cursor: pointer; transition: background .2s, color .2s; grid-column: 1/-1; margin-top: 4px;
}
.submit-btn:hover:not(:disabled) { background: var(--text); color: var(--bg) }
.submit-btn:disabled { opacity: .45; cursor: not-allowed }

/* SUCCESS */
.success-state {
  display: none;
  text-align: center;
  padding: 48px 24px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  margin-top: 32px;
}
.success-icon {
  width: 48px; height: 48px;
  background: var(--green-bg);
  border: 1px solid var(--green-border);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 16px;
}
.success-icon svg { width: 20px; height: 20px; stroke: var(--green); fill: none; stroke-width: 2 }
.success-state.show { display: block; animation: scale-in .5s cubic-bezier(.16,1,.3,1) both }
.success-state.show .success-icon svg polyline {
  stroke-dasharray: 30;
  animation: draw-check .6s ease .25s both;
}
</style>

<div class="page">
  <div class="sec-label anim" style="margin-bottom:6px;--d:.05s">book a session</div>
  <h1 class="anim" style="font-size:24px;font-weight:300;letter-spacing:-.02em;margin-bottom:4px;--d:.12s">Request a session</h1>
  <p class="anim" style="font-size:13px;color:var(--text-3);margin-bottom:32px;--d:.2s">Pick a package and fill in the basics. You'll finalize location and add-ons after confirmation.</p>

  <!-- PACKAGES -->
  <div class="sec-label">choose a package</div>
  <div class="pkg-grid" id="pkg-grid">
    <div class="pkg-card unavail" style="height:120px"></div>
    <div class="pkg-card unavail" style="height:120px"></div>
    <div class="pkg-card unavail" style="height:120px"></div>
  </div>

  <!-- FORM -->
  <div class="sec-label">your details</div>
  <form id="book-form">
    <div class="form-grid">
      <div class="field"><label>First name</label><input type="text" id="f-first" placeholder="Jordan" required/></div>
      <div class="field"><label>Last name</label><input type="text"  id="f-last"  placeholder="Smith"  required/></div>
      <div class="field"><label>Email</label><input type="email" id="f-email" placeholder="you@email.com" required/></div>
      <div class="field"><label>Phone</label><input type="tel" id="f-phone" placeholder="(229) 555-0100"/></div>

      <hr class="divider" style="grid-column:1/-1"/>

      <div class="field full">
        <label>Session date</label>
        <input type="hidden" id="f-date"/>
        <div class="cal">
          <div class="cal-head">
            <button type="button" class="cal-nav" onclick="calShift(-1)" aria-label="Previous month">‹</button>
            <span class="cal-title" id="cal-title">—</span>
            <button type="button" class="cal-nav" onclick="calShift(1)" aria-label="Next month">›</button>
          </div>
          <div class="cal-dow"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
          <div class="cal-days" id="cal-days"></div>
          <div class="cal-legend">
            <span><i style="background:var(--green)"></i>open</span>
            <span><i style="background:var(--amber)"></i>limited</span>
            <span class="lg-strike">15</span><span style="margin-left:-6px">booked</span>
          </div>
        </div>
        <p class="cal-picked" id="cal-picked"></p>
      </div>
      <div class="field">
        <label>Start time</label>
        <input type="time" id="f-time" onclick="this.showPicker()" onkeydown="return false" style="cursor:pointer"/>
      </div>
      <div class="field">
        <label>Session type</label>
        <select id="f-sport" required>
          <option value="" disabled selected>Select…</option>
          <option>Portraits</option><option>Family</option><option>Senior photos</option>
          <option>Couples / Engagement</option><option>Event</option><option>Sports</option>
          <option>Branding / Product</option><option>Other</option>
        </select>
      </div>

      <!-- per-session-type follow-up questions render here -->
      <div id="type-questions" style="display:contents"></div>

      <hr class="divider" style="grid-column:1/-1"/>

      <!-- COST BOX -->
      <div class="cost-box">
        <div class="cost-label">Package estimate</div>
        <div id="cost-empty" class="cost-empty">Select a package above to see pricing.</div>
        <div id="cost-lines" style="display:none">
          <div class="cost-line"><span id="cl-pkg-n"></span><span id="cl-pkg-p"></span></div>
          <div class="cost-line" id="cl-coupon" style="display:none;color:var(--green)"><span id="cl-coupon-n"></span><span id="cl-coupon-v"></span></div>
          <div class="cost-line total"><span>Base total</span><span id="cl-total"></span></div>
          <div class="cost-line note"><span>Add-ons and location finalized after acceptance.</span></div>
        </div>
        <div style="display:flex;gap:8px;margin-top:12px">
          <input type="text" id="f-coupon" placeholder="Promo code (optional)" style="text-transform:uppercase;flex:1;min-width:0" oninput="this.value=this.value.toUpperCase()"/>
          <button type="button" class="btn" id="coupon-btn" onclick="applyCoupon()" style="flex-shrink:0">Apply</button>
        </div>
        <div id="coupon-status" style="font-size:11px;margin-top:6px;min-height:14px;color:var(--text-3)"></div>
      </div>

      <hr class="divider" style="grid-column:1/-1"/>

      <div class="field full">
        <label>Anything else? (optional)</label>
        <textarea id="f-notes" placeholder="Location ideas, who or what we're shooting, questions, etc."></textarea>
      </div>

      <div class="agree-row">
        <input type="checkbox" id="f-agree" required/>
        <label for="f-agree">I have read and agree to the <a href="/privacy" target="_blank">Privacy Policy</a>. I confirm I am at least 13 years old, or I am a parent/guardian submitting this on behalf of a minor.</label>
      </div>

      <button type="submit" class="submit-btn" id="submit-btn" disabled>Select a package to continue</button>
    </div>
  </form>

  <div class="success-state" id="success-state">
    <div class="success-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
    <h2 style="font-size:18px;font-weight:400;margin-bottom:8px">Request sent!</h2>
    <p style="font-size:13px;color:var(--text-3);line-height:1.7;max-width:340px;margin:0 auto">Zachary will review your request and email you within 24 hours with a link to finalize your booking.</p>
  </div>
</div>

<script>
import { createClient } from '@supabase/supabase-js';
const sb = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const DEFAULT_PKGS = [
  { name:'Basic',    price:40,  popular:false, on_sale:false, features:['1–2 hrs coverage','25 edited photos','Private gallery link'] },
  { name:'Standard', price:75,  popular:true,  on_sale:false, features:['Up to 3 hrs coverage','60 edited photos','Private gallery link','1 free 5×7 print'] },
  { name:'Premium',  price:120, popular:false, on_sale:false, features:['Full day coverage','100+ edited photos','Private gallery link','3 free 5×7 prints'] },
];

let selPkg = null;

async function loadPackages() {
  const { data } = await sb.from('package_pricing').select('*').eq('available', true).order('base_price');
  const pkgs = (data && data.length)
    ? data.map((p, i) => ({
        name:     p.package_name,
        price:    (p.on_sale && p.sale_price) ? p.sale_price : p.base_price,
        origPrice: (p.on_sale && p.sale_price) ? p.base_price : null,
        popular:  p.package_name === 'Standard',
        on_sale:  !!(p.on_sale && p.sale_price),
        features: DEFAULT_PKGS[i]?.features || ['Photos included', 'Private gallery link'],
      }))
    : DEFAULT_PKGS;
  renderPackages(pkgs);
}

function renderPackages(pkgs) {
  const grid = document.getElementById('pkg-grid');
  grid.innerHTML = pkgs.map((p, i) => `
    <div class="pkg-card" id="pkg-${i}" style="--d:${i * 0.08}s" onclick="selectPkg(${i},${JSON.stringify(p).replace(/"/g,'&quot;')})">
      ${p.popular ? '<span class="pkg-badge">Popular</span>' : ''}
      <div class="pkg-name">${p.name}</div>
      ${p.on_sale ? `<span class="pkg-sale-badge">Sale</span>` : ''}
      ${p.origPrice ? `<div class="pkg-orig">$${p.origPrice}</div>` : ''}
      <div class="pkg-price${p.on_sale ? ' sale' : ''}">$${p.price}<small>/session</small></div>
      <ul class="pkg-features">${p.features.map(f => `<li>${f}</li>`).join('')}</ul>
    </div>`).join('');
}

function selectPkg(i, pkg) {
  selPkg = pkg;
  document.querySelectorAll('.pkg-card').forEach((c, j) => c.classList.toggle('sel', j === i));
  updateCostBox();
  const btn = document.getElementById('submit-btn');
  btn.disabled = false;
  btn.textContent = 'Send booking request';
}
window.selectPkg = selectPkg;

// ── COUPONS ──
let appliedCoupon = null; // row from `coupons` or null

async function validateCoupon(code) {
  try {
    const { data, error } = await sb.from('coupons')
      .select('*').eq('code', code).eq('active', true).maybeSingle();
    if (error || !data) return { err: 'Invalid code' };
    if (data.expires_at && new Date(data.expires_at) < new Date()) return { err: 'This code has expired' };
    if (data.max_uses !== null && (data.uses || 0) >= data.max_uses) return { err: 'This code has been fully redeemed' };
    return { coupon: data };
  } catch (_) {
    return { err: 'Could not check the code — try again' };
  }
}

async function applyCoupon() {
  const code = document.getElementById('f-coupon').value.trim().toUpperCase();
  const status = document.getElementById('coupon-status');
  if (!code) { appliedCoupon = null; status.textContent = ''; updateCostBox(); return; }
  status.textContent = 'Checking…';
  const { coupon, err } = await validateCoupon(code);
  if (err) {
    appliedCoupon = null;
    status.textContent = err;
    status.style.color = 'var(--red)';
  } else {
    appliedCoupon = coupon;
    status.textContent = '✓ ' + code + ' applied';
    status.style.color = 'var(--green)';
  }
  updateCostBox();
}
window.applyCoupon = applyCoupon;

function couponDiscount(pkgPrice) {
  if (!appliedCoupon) return 0;
  if (appliedCoupon.type === 'percent')
    return Math.round(pkgPrice * (appliedCoupon.value / 100) * 100) / 100;
  if (appliedCoupon.type === 'fixed')
    return Math.min(appliedCoupon.value, pkgPrice); // never below $0
  return 0; // 'travel' — waives the travel fee, which is added later at confirmation
}

function updateCostBox() {
  if (!selPkg) return;
  const disc  = couponDiscount(selPkg.price);
  const total = Math.max(0, Math.round((selPkg.price - disc) * 100) / 100);
  document.getElementById('cl-pkg-n').textContent = selPkg.name + ' package';
  document.getElementById('cl-pkg-p').textContent = '$' + selPkg.price;
  const line = document.getElementById('cl-coupon');
  if (appliedCoupon && (disc > 0 || appliedCoupon.type === 'travel')) {
    document.getElementById('cl-coupon-n').textContent = 'Coupon ' + appliedCoupon.code;
    document.getElementById('cl-coupon-v').textContent =
      appliedCoupon.type === 'travel' ? 'Travel fee waived' : '−$' + disc.toFixed(2);
    line.style.display = 'flex';
  } else {
    line.style.display = 'none';
  }
  document.getElementById('cl-total').textContent = '$' + total.toFixed(2);
  document.getElementById('cost-empty').style.display = 'none';
  document.getElementById('cost-lines').style.display = 'block';
}

// ── AVAILABILITY CALENDAR ──
// Reads the same `availability` table the admin marks up:
// full-day 'unavailable' = not bookable; 'partial' = bookable with a heads-up.
let availBlocks = [], calY, calM, pickedDate = null, pickedPartial = false;

function localToday() {
  const n = new Date();
  return `${n.getFullYear()}-${String(n.getMonth()+1).padStart(2,'0')}-${String(n.getDate()).padStart(2,'0')}`;
}

function dayStatus(ds) {
  const bs = availBlocks.filter(b => b.date === ds);
  if (!bs.length) return null;
  if (bs.some(b => b.status === 'unavailable' && !b.start_time)) return 'unavailable';
  if (bs.some(b => b.status === 'partial' || (b.status === 'unavailable' && b.start_time))) return 'partial';
  if (bs.some(b => b.status === 'available')) return 'available';
  return null;
}

async function loadAvailability() {
  try {
    const { data } = await sb.from('availability')
      .select('date, status, start_time')
      .gte('date', localToday());
    availBlocks = data || [];
  } catch (_) {}
  renderCal();
}

function renderCal() {
  const today = localToday();
  document.getElementById('cal-title').textContent =
    new Date(calY, calM, 1).toLocaleString('default', { month: 'long', year: 'numeric' });

  // don't navigate into the past
  const n = new Date();
  document.querySelector('.cal-nav').disabled = (calY === n.getFullYear() && calM === n.getMonth());

  const grid = document.getElementById('cal-days');
  grid.innerHTML = '';
  const firstDay = new Date(calY, calM, 1).getDay();
  const daysInMonth = new Date(calY, calM + 1, 0).getDate();
  const monthStr = `${calY}-${String(calM + 1).padStart(2, '0')}`;

  for (let i = 0; i < firstDay; i++) {
    const el = document.createElement('div');
    el.className = 'cal-d empty';
    grid.appendChild(el);
  }
  for (let d = 1; d <= daysInMonth; d++) {
    const ds = `${monthStr}-${String(d).padStart(2, '0')}`;
    const status = dayStatus(ds);
    const isPast = ds < today;
    const blocked = status === 'unavailable';

    const el = document.createElement('button');
    el.type = 'button';
    el.textContent = d;
    let cls = 'cal-d';
    if (blocked) cls += ' blocked';
    if (ds === pickedDate) cls += ' sel';
    el.className = cls;
    el.disabled = isPast || blocked;

    if (!isPast && (status === 'partial' || status === 'available')) {
      const dot = document.createElement('span');
      dot.className = 'dot';
      dot.style.background = status === 'partial' ? 'var(--amber)' : 'var(--green)';
      el.appendChild(dot);
    }
    if (!el.disabled) el.addEventListener('click', () => pickDate(ds, status === 'partial'));
    grid.appendChild(el);
  }
}

function pickDate(ds, partial) {
  pickedDate = ds;
  pickedPartial = partial;
  document.getElementById('f-date').value = ds;
  const nice = new Date(ds + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
  document.getElementById('cal-picked').innerHTML =
    'Selected — <b>' + nice + '</b>' + (partial ? ' · limited availability, time will be confirmed' : '');
  renderCal();
}

function calShift(dir) {
  calM += dir;
  if (calM > 11) { calM = 0; calY++; }
  if (calM < 0)  { calM = 11; calY--; }
  renderCal();
}
window.calShift = calShift;

// ── SESSION-TYPE FOLLOW-UP QUESTIONS ──
const TYPE_QUESTIONS = {
  'Portraits': [
    { label: 'Who is the session for?', ph: 'e.g. Just me / my daughter' },
    { label: 'Indoor or outdoor?', options: ['Outdoor', 'Indoor', 'Both', 'Not sure'] },
  ],
  'Family': [
    { label: 'How many people?', ph: 'e.g. 5', type: 'number' },
    { label: 'Young kids or pets coming?', ph: 'e.g. Two kids (3 & 6), one dog' },
  ],
  'Senior photos': [
    { label: 'School & class year', ph: 'e.g. Valdosta High, 2027' },
    { label: 'Outfit changes?', options: ['1 outfit', '2 outfits', '3+', 'Not sure'] },
  ],
  'Couples / Engagement': [
    { label: "Partner's name", ph: 'e.g. Sam' },
    { label: 'Surprise proposal?', options: ['No', 'Yes — keep it a secret'] },
  ],
  'Event': [
    { label: 'What kind of event?', ph: 'e.g. Birthday, graduation party' },
    { label: 'Rough guest count', ph: 'e.g. 40', type: 'number' },
  ],
  'Sports': [
    { label: 'Sport & team', ph: 'e.g. Football — Valdosta Wildcats' },
    { label: 'Player name & number', ph: 'e.g. Jordan Smith, #24' },
  ],
  'Branding / Product': [
    { label: 'Business / brand name', ph: 'e.g. South GA Coffee Co.' },
    { label: 'What are we shooting?', ph: 'e.g. Menu items, headshots' },
  ],
  'Other': [
    { label: 'What do you have in mind?', ph: 'Tell me a little about it' },
  ],
};

function renderTypeQuestions() {
  const type = document.getElementById('f-sport').value;
  const qs = TYPE_QUESTIONS[type] || [];
  const wrap = document.getElementById('type-questions');
  wrap.innerHTML = qs.map((q, i) => {
    const cls = qs.length === 1 ? 'field full' : 'field';
    if (q.options) {
      return `<div class="${cls}"><label>${q.label}</label>
        <select class="tq" data-label="${q.label}">
          <option value="" selected>Select… (optional)</option>
          ${q.options.map(o => `<option>${o}</option>`).join('')}
        </select></div>`;
    }
    return `<div class="${cls}"><label>${q.label}</label>
      <input type="${q.type || 'text'}" class="tq" data-label="${q.label}" placeholder="${q.ph || ''}"/></div>`;
  }).join('');
}

function collectTypeAnswers() {
  return [...document.querySelectorAll('#type-questions .tq')]
    .map(el => ({ label: el.dataset.label, val: el.value.trim() }))
    .filter(a => a.val)
    .map(a => a.label.replace(/\?$/, '') + ': ' + a.val)
    .join(' | ');
}

document.getElementById('f-sport').addEventListener('change', renderTypeQuestions);

document.getElementById('book-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  if (!selPkg) { alert('Please select a package first.'); return; }
  if (!document.getElementById('f-date').value) { alert('Pick an open date on the calendar first.'); return; }

  const btn = document.getElementById('submit-btn');
  btn.disabled = true; btn.textContent = 'Sending…';

  const typeAnswers = collectTypeAnswers();
  const freeNotes   = document.getElementById('f-notes').value.trim();
  const dateNote    = pickedPartial ? 'Client picked a limited-availability day' : '';

  // Re-validate the coupon at submit time so a code deactivated mid-session isn't honored
  let disc = 0, couponNote = '';
  if (appliedCoupon) {
    const { coupon } = await validateCoupon(appliedCoupon.code);
    if (coupon) {
      appliedCoupon = coupon;
      disc = couponDiscount(selPkg.price);
      couponNote = appliedCoupon.type === 'travel'
        ? 'Coupon ' + appliedCoupon.code + ' (travel fee waived)'
        : 'Coupon ' + appliedCoupon.code + ' (−$' + disc.toFixed(2) + ')';
    } else {
      appliedCoupon = null;
      updateCostBox();
    }
  }
  const finalTotal = Math.max(0, Math.round((selPkg.price - disc) * 100) / 100);

  try {
    await sb.from('bookings').insert({
      first_name:       document.getElementById('f-first').value.trim(),
      last_name:        document.getElementById('f-last').value.trim(),
      email:            document.getElementById('f-email').value.trim(),
      phone:            document.getElementById('f-phone').value.trim() || null,
      event_date:       document.getElementById('f-date').value || null,
      event_time:       document.getElementById('f-time').value || null,
      sport_type:       document.getElementById('f-sport').value,
      package_selected: selPkg.name + ' — $' + selPkg.price,
      total:            '$' + finalTotal.toFixed(2),
      deposit:          '$' + (finalTotal / 2).toFixed(2),
      notes:            [typeAnswers, dateNote, couponNote, freeNotes].filter(Boolean).join(' | ') || null,
      status:           'pending',
    });
  } catch(err) {
    btn.disabled = false; btn.textContent = 'Send booking request';
    alert('Something went wrong — please try again.');
    return;
  }

  document.getElementById('book-form').style.display = 'none';
  document.querySelector('.pkg-grid').style.display = 'none';
  document.querySelector('[style*="choose a package"]')?.style && null;
  document.querySelectorAll('.sec-label').forEach(el => el.style.display = 'none');
  document.querySelector('h1').style.display = 'none';
  document.querySelector('p[style*="text-3"]').style.display = 'none';
  document.getElementById('success-state').classList.add('show');
});

const _now = new Date();
calY = _now.getFullYear();
calM = _now.getMonth();
renderCal();
loadAvailability();
loadPackages();

// Prefill promo code from admin share links: /book?coupon=CODE
const urlCoupon = new URLSearchParams(window.location.search).get('coupon');
if (urlCoupon) {
  document.getElementById('f-coupon').value = urlCoupon.toUpperCase();
  applyCoupon();
}
</script>
</Layout>
