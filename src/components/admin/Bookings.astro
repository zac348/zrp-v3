---
import { BOOKING_OPEN } from '../../config.js';
---
<!-- BOOKINGS -->
  <div class="tab" id="tab-bookings">
    <h1 class="main-title">Bookings</h1>
    <p class="main-sub">Review new enquiries above. Accepted requests move into Active bookings below.</p>
    {BOOKING_OPEN && (
    <section class="booking-pause" id="booking-pause" aria-labelledby="booking-pause-heading">
      <div class="booking-pause-head"><h2 id="booking-pause-heading">Online booking</h2><p id="booking-pause-state" role="status">Checking…</p></div>
      <p class="booking-pause-timer" id="booking-pause-timer" hidden></p>
      <form class="booking-pause-form" id="booking-pause-form">
        <div class="field dp"><span id="booking-resume-label">Resume bookings on</span><input type="hidden" id="booking-resume-date"/><button type="button" class="dp-trigger" id="booking-resume-trigger" aria-haspopup="dialog" aria-expanded="false" aria-labelledby="booking-resume-label booking-resume-trigger">Choose a date</button><div class="dp-pop" id="booking-resume-pop" role="dialog" aria-label="Choose the date bookings resume" hidden></div></div>
        <button type="submit" class="btn" id="booking-pause-save">Pause bookings</button>
        <button type="button" class="btn-sm" id="booking-resume-now" hidden>Resume now</button>
      </form>
      <p class="booking-pause-note">While paused, the booking page says “Zachary will be accepting bookings soon” with a countdown, and new requests are refused. Booking reopens by itself at 12:00 AM Eastern on the date you pick. The contact form stays open.</p>
    </section>
    )}
    <div class="delivery-controls">
      <button class="btn-sm" id="delivery-refresh" type="button">Refresh</button>
      <button class="btn-sm" id="delivery-check" type="button">Check Drive connection</button>
    </div>
    <p class="delivery-status" id="delivery-admin-status" role="status" aria-live="polite"></p>
    <section class="booking-section" aria-labelledby="new-enquiries-heading">
      <header class="booking-section-heading"><h2 id="new-enquiries-heading">New enquiries</h2><span id="booking-count-new">0</span></header>
      <div id="booking-list-new"><p class="no-data">Loading enquiries…</p></div>
    </section>
    <section class="booking-section" aria-labelledby="active-bookings-heading">
      <header class="booking-section-heading"><h2 id="active-bookings-heading">Active bookings</h2><span id="booking-count-active">0</span></header>
      <div id="booking-list-active"><p class="no-data">Loading bookings…</p></div>
    </section>
    <details class="booking-section booking-history">
      <summary>Completed &amp; declined <span id="booking-count-history">0</span></summary>
      <div id="booking-list-history"></div>
    </details>
  </div>
