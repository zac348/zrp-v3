---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — Zachary Routsong Photography">
<style>.nf{max-width:760px;margin:auto;padding:96px var(--gutter)}.nf h1{margin:24px 0}.nf p{margin-bottom:32px;color:var(--muted)}</style>

<div class="nf">
  <div class="nf-inner">
    <p class="nf-code">404 — Not found</p>
    <h1>Page not found</h1>
    <p>This page doesn't exist — it may have moved, or the link has a typo.</p>
    <span><a href="/" class="btn">Back to home</a></span>
  </div>
</div>
</Layout>
