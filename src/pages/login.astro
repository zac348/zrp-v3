---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Admin Login — ZRP" noNav={true} noFooter={true}>
<style is:global>
body { min-height: 100vh; display: flex; align-items: center; justify-content: center }
.box { width: 100%; max-width: 340px; padding: 0 24px }
.logo {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-3);
  text-align: center;
  margin-bottom: 40px;
}
.title { font-size: 20px; font-weight: 300; text-align: center; margin-bottom: 4px; letter-spacing: -.02em }
.sub { font-size: 12px; color: var(--text-3); text-align: center; margin-bottom: 32px }
.field { display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px }
.err { font-size: 11px; color: var(--red); text-align: center; margin-top: 10px; display: none }
.ok  { font-size: 11px; color: var(--green); text-align: center; margin-top: 10px; display: none }
.back { display: block; text-align: center; margin-top: 20px; font-size: 11px; color: var(--text-3); text-decoration: none; transition: color .15s }
.back:hover { color: var(--text) }
.forgot {
  display: block;
  margin: 14px auto 0;
  background: none;
  border: none;
  font-family: inherit;
  font-size: 11px;
  color: var(--text-3);
  text-decoration: underline;
  cursor: pointer;
  transition: color .15s;
}
.forgot:hover { color: var(--text) }
</style>

<div class="box">
  <p class="logo">Zachary Routsong Photography</p>
  <h1 class="title">Admin login</h1>
  <p class="sub">Zachary only — manage your site.</p>

  <div class="field">
    <label>Email</label>
    <input type="email" id="email" placeholder="you@email.com" autocomplete="email"/>
  </div>
  <div class="field">
    <label>Password</label>
    <input type="password" id="password" placeholder="••••••••" autocomplete="current-password"/>
  </div>

  <button class="btn" style="width:100%;margin-top:4px" id="login-btn" onclick="doLogin()">Sign in</button>
  <p class="err" id="err-msg"></p>
  <p class="ok" id="ok-msg"></p>
  <button class="forgot" id="forgot-btn" onclick="forgotPw()">Forgot password?</button>
  <a href="/" class="back">← Back to site</a>
</div>

<script>
import { createClient } from '@supabase/supabase-js';
const sb = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

// Redirect if already logged in
sb.auth.getSession().then(({ data }) => {
  if (data.session) window.location.href = '/admin';
});

function showErr(msg) {
  const errEl = document.getElementById('err-msg');
  document.getElementById('ok-msg').style.display = 'none';
  errEl.textContent = msg;
  errEl.style.display = 'block';
}
function showOk(msg) {
  const okEl = document.getElementById('ok-msg');
  document.getElementById('err-msg').style.display = 'none';
  okEl.textContent = msg;
  okEl.style.display = 'block';
}

// Translate Supabase errors into something specific
function friendlyError(error) {
  const m = (error && error.message) || '';
  if (m.includes('Invalid login credentials')) return 'Wrong email or password.';
  if (m.includes('Email not confirmed'))       return 'This email has not been confirmed yet.';
  if (m.includes('rate limit') || m.includes('too many')) return 'Too many attempts — wait a minute and try again.';
  if (m.includes('Failed to fetch') || m.includes('NetworkError')) return 'Could not reach the login service — check your connection and try again.';
  return m || 'Something went wrong — try again.';
}

async function doLogin() {
  const email    = document.getElementById('email').value.trim();
  const password = document.getElementById('password').value;
  const btn      = document.getElementById('login-btn');
  document.getElementById('err-msg').style.display = 'none';
  btn.disabled = true; btn.textContent = 'Signing in…';

  const { error } = await sb.auth.signInWithPassword({ email, password });
  if (error) {
    showErr(friendlyError(error));
    btn.disabled = false; btn.textContent = 'Sign in';
  } else {
    window.location.href = '/admin';
  }
}
window.doLogin = doLogin;

async function forgotPw() {
  const email = document.getElementById('email').value.trim();
  if (!email) { showErr('Type your email in the box above first, then click "Forgot password?" again.'); return; }
  const btn = document.getElementById('forgot-btn');
  btn.disabled = true; btn.textContent = 'Sending…';

  const { error } = await sb.auth.resetPasswordForEmail(email, {
    redirectTo: window.location.origin + '/reset',
  });
  btn.disabled = false; btn.textContent = 'Forgot password?';
  if (error) {
    showErr(friendlyError(error));
  } else {
    showOk('If an account exists for ' + email + ', a reset link is on its way. Check your inbox.');
  }
}
window.forgotPw = forgotPw;

document.addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });
</script>
</Layout>
