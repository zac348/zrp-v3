---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Coupon Card Generator — ZRP" noNav={true}>
<style>
nav.nav { display: flex; align-items: center; justify-content: space-between; padding: 0 28px; height: 56px; border-bottom: 1px solid var(--rule); background: var(--canvas); position: sticky; top: 0; z-index: 10 }
.nav-back { font-size: 12px; color: var(--muted); text-decoration: none; transition: color .15s }
.nav-back:hover { color: var(--ink) }

.page { max-width: 920px; margin: 0 auto; padding: 44px 24px 80px; display: grid; grid-template-columns: 300px 1fr; gap: 40px; align-items: start }
@media (max-width: 700px) { .page { grid-template-columns: 1fr } }

.controls { background: var(--surface); border: 1px solid var(--rule);  padding: 20px; position: sticky; top: 76px }
.ctrl-field { margin-bottom: 12px }

.preview-label { font-family: var(--font-sans); font-size: 12px; letter-spacing: .01em; color: var(--muted); margin-bottom: 12px; display: flex; align-items: center; gap: 8px }
.preview-label::after { content: ''; flex: 1; height: 1px; background: var(--rule) }

.canvas-wrap { border: 1px solid var(--rule);  overflow: hidden; aspect-ratio: 6/4; position: relative }
.canvas-wrap canvas { width: 100%; height: 100%; display: block }
.nav a{min-height:44px;display:flex;align-items:center}.controls .btn{width:100%;margin-top:12px}.controls p{font-size:13px;margin-top:12px}.page{font-size:14px}.preview-label span{color:var(--muted)}@media(max-width:700px){.controls{position:static}}
</style>

<nav class="nav">
  <a href="/" class="nav-logo">ZRP</a>
  <a href="/admin" class="nav-back">← Back to admin</a>
</nav>

<div class="page">
  <!-- CONTROLS -->
  <div class="controls">
    <div class="sec-label">customize</div>

    <div class="ctrl-field field">
      <label for="env-client">Client name (optional)</label>
      <input type="text" id="env-client" placeholder="e.g. Smith Family" />
    </div>
    <div class="ctrl-field field">
      <label for="env-code">Coupon code</label>
      <input type="text" id="env-code" placeholder="e.g. SUMMER25" />
    </div>
    <div class="ctrl-field field">
      <label for="env-discount">Discount label</label>
      <input type="text" id="env-discount" placeholder="e.g. 20% off" />
    </div>
    <div class="ctrl-field field">
      <label for="env-msg">Message (optional)</label>
      <input type="text" id="env-msg" placeholder="Thank you for your business!" maxlength="60" />
    </div>
    <div class="ctrl-field field">
      <label for="env-expiry">Expiry (optional)</label>
      <input type="text" id="env-expiry" placeholder="e.g. Expires 12/31/2025" />
    </div>
    <div class="ctrl-field field">
      <label for="env-style">Style</label>
      <select id="env-style" >
        <option value="light">Light — white</option>
        <option value="dark">Dark — black</option>
      </select>
    </div>

    <button class="btn" id="download-card">Download PNG</button>
    <p>Print at 6×4 inches</p>
  </div>

  <!-- PREVIEW -->
  <div>
    <div class="preview-label">preview <span>(scaled)</span></div>
    <div class="canvas-wrap">
      <canvas id="card-canvas"></canvas>
    </div>
  </div>
</div>

<script>
const canvas = document.getElementById('card-canvas');
const ctx = canvas.getContext('2d');
canvas.width  = 1800;
canvas.height = 1200;

function val(id) { return document.getElementById(id)?.value || ''; }

function render() {
  const style    = val('env-style');
  const isDark   = style === 'dark';
  const client   = val('env-client');
  const code     = val('env-code') || 'CODE';
  const discount = val('env-discount') || 'Discount';
  const msg      = val('env-msg');
  const expiry   = val('env-expiry');

  const bg   = isDark ? '#202020' : '#f8f8f8';
  const text1 = isDark ? '#ededed' : '#202020';
  const text2 = isDark ? '#9A9997' : '#6B6967';
  const text3 = isDark ? '#5A5957' : '#AEADA9';
  const border = isDark ? '#2E2D2C' : '#E5E5E0';

  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // Background
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // Border
  ctx.strokeStyle = border;
  ctx.lineWidth = 2;
  ctx.strokeRect(1, 1, canvas.width-2, canvas.height-2);

  // Left accent line
  ctx.fillStyle = text1;
  ctx.fillRect(0, 0, 8, canvas.height);

  // LOGO
  ctx.fillStyle = text3;
  ctx.font = '500 28px "Public Sans", sans-serif';
  ctx.letterSpacing = '6px';
  ctx.fillText('ZRP', 60, 80);
  ctx.letterSpacing = '0px';

  // Divider line
  ctx.fillStyle = border;
  ctx.fillRect(60, 100, canvas.width - 120, 1);

  // Client name
  if (client) {
    ctx.fillStyle = text2;
    ctx.font = '300 32px "Public Sans", sans-serif';
    ctx.fillText('For: ' + client, 60, 180);
  }

  // Discount
  ctx.fillStyle = text1;
  ctx.font = '400 160px "Bodoni Moda", sans-serif';
  ctx.fillText(discount, 60, client ? 400 : 380);

  // Code
  ctx.fillStyle = text2;
  ctx.font = '500 44px "Public Sans", sans-serif';
  ctx.letterSpacing = '4px';
  ctx.fillText('Use code:', 60, client ? 520 : 500);
  ctx.letterSpacing = '0px';

  ctx.fillStyle = text1;
  ctx.font = '700 80px "Public Sans", sans-serif';
  ctx.letterSpacing = '6px';
  ctx.fillText(code, 60, client ? 630 : 610);
  ctx.letterSpacing = '0px';

  // Divider
  ctx.fillStyle = border;
  ctx.fillRect(60, client ? 680 : 660, canvas.width - 120, 1);

  // Message
  if (msg) {
    ctx.fillStyle = text2;
    ctx.font = '400 30px "Public Sans", sans-serif';
    ctx.fillText(msg, 60, client ? 740 : 720);
  }

  // Bottom row
  ctx.fillStyle = text3;
  ctx.font = '400 26px "Public Sans", sans-serif';
  ctx.letterSpacing = '1px';
  ctx.fillText('zrphotos.net', 60, 1150);
  ctx.letterSpacing = '0px';

  if (expiry) {
    ctx.textAlign = 'right';
    ctx.fillText(expiry, canvas.width - 60, 1150);
    ctx.textAlign = 'left';
  }
}

async function download() {
  await document.fonts.ready;
  render();
  const a = document.createElement('a');
  a.download = 'coupon-card.png';
  a.href = canvas.toDataURL('image/png');
  a.click();
}
document.getElementById('download-card').addEventListener('click',download);
document.querySelectorAll('.controls input,.controls select').forEach(input=>input.addEventListener('input',()=>{if(input.id==='env-code')input.value=input.value.toUpperCase();render();}));

document.fonts.ready.then(render);
</script>
</Layout>
