<dialog class="photo-viewer" id="photo-viewer" aria-label="Photograph viewer">
  <div class="viewer-top"><span id="viewer-count"></span><button type="button" class="viewer-close" aria-label="Close photograph viewer">Close <span aria-hidden="true">×</span></button></div>
  <div class="viewer-stage"><img id="viewer-image" alt=""/><p id="viewer-status" role="status" hidden></p></div>
  <div class="viewer-bottom"><p id="viewer-caption"></p><div><button type="button" id="viewer-prev" aria-label="Previous photograph">←</button><button type="button" id="viewer-next" aria-label="Next photograph">→</button></div></div>
</dialog>
