---
import Layout from '../layouts/Layout.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import '../styles/collection.css';
import {PRIMARY_CTA} from '../config.js';
---
<Layout title="The photographs — Zachary Routsong" description="Explore Zachary Routsong’s photographs of sports and places, with a filterable portfolio and full-size photo viewer.">
  <div class="archive page-inset">
    <SectionHeading level={1} title="Photographs"><p id="port-total" role="status">Loading the collection</p></SectionHeading>
    <section id="portfolio" aria-label="Photograph collection"><div class="archive-tools"><div class="category-filters" id="cat-tags" aria-label="Filter photographs"></div></div><div class="archive-grid" id="portfolio-grid" aria-busy="true"><p class="collection-message">Loading photographs…</p></div><div class="collection-bottom"><p id="port-count" aria-live="polite"></p><button type="button" class="line-link" id="load-more" hidden>Show more photographs</button></div></section>
    <div class="archive-contact"><Button href={PRIMARY_CTA.href}>{PRIMARY_CTA.label}</Button><a class="line-link" href="sms:+12293001006">Text Zachary</a></div>
  </div>
  <noscript><p class="no-script">Enable JavaScript to load the photographs, or <a href="https://instagram.com/zacharyroutsongphotos">see Zachary’s work on Instagram</a>.</p></noscript>
  <PhotoViewer/>
  <script src="../lib/archive.js"></script>
</Layout>
<style>.archive{padding-block:64px}.archive-tools{border-block:1px solid var(--rule);padding-block:12px;margin-bottom:40px}.archive-contact{display:flex;gap:24px;margin-top:48px}#port-total{font-size:14px;color:var(--muted)}@media(max-width:600px){.archive{padding-block:40px}}</style>
