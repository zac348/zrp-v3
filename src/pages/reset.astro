---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Reset Password — ZRP" noNav={true} noFooter={true}>


<div class="box">
  <p class="logo">Zachary Routsong Photography</p>
  <h1 class="title">Set a new password</h1>
  <p class="sub" id="sub-msg">Checking your reset link…</p>

  <div id="form-wrap" hidden>
    <div class="field">
      <label for="pw1">New password</label>
      <input type="password" id="pw1" placeholder="••••••••" autocomplete="new-password"/>
    </div>
    <div class="field">
      <label for="pw2">Confirm new password</label>
      <input type="password" id="pw2" placeholder="••••••••" autocomplete="new-password"/>
    </div>
    <button class="btn" id="save-btn">Save new password</button>
  </div>

  <p class="err" id="err-msg" hidden role="alert"></p>
  <p class="ok" id="ok-msg" hidden role="status"></p>
  <a href="/login" class="back">← Back to login</a>
</div>

<script>
import { createClient } from '@supabase/supabase-js';
const sb = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const subEl  = document.getElementById('sub-msg');
const formEl = document.getElementById('form-wrap');
const errEl  = document.getElementById('err-msg');
const okEl   = document.getElementById('ok-msg');

let linkOk = false;

function enableForm() {
  if (linkOk) return;
  linkOk = true;
  subEl.textContent = 'Choose a new password for your admin account.';
  formEl.hidden = false;
  errEl.hidden = true;
}

// The reset link signs the visitor in with a temporary recovery session.
// supabase-js parses it from the URL automatically; we just wait for it.
sb.auth.onAuthStateChange((_event, session) => {
  if (session) enableForm();
});
sb.auth.getSession().then(({ data }) => {
  if (data.session) enableForm();
});
setTimeout(() => {
  if (!linkOk) {
    subEl.textContent = 'This reset link is invalid or has expired.';
    errEl.textContent = 'Go back to the login page and click "Forgot password?" to get a fresh link.';
    errEl.hidden = false;
  }
}, 2500);

async function savePw() {
  const p1 = document.getElementById('pw1').value;
  const p2 = document.getElementById('pw2').value;
  errEl.hidden = true;

  if (p1.length < 8) {
    errEl.textContent = 'Password needs to be at least 8 characters.';
    errEl.hidden = false;
    return;
  }
  if (p1 !== p2) {
    errEl.textContent = 'Passwords do not match.';
    errEl.hidden = false;
    return;
  }

  const btn = document.getElementById('save-btn');
  btn.disabled = true; btn.textContent = 'Saving…';

  const { error } = await sb.auth.updateUser({ password: p1 });
  if (error) {
    errEl.textContent = error.message || 'Could not update the password — try again.';
    errEl.hidden = false;
    btn.disabled = false; btn.textContent = 'Save new password';
  } else {
    okEl.textContent = 'Password updated — taking you to the dashboard…';
    okEl.hidden = false;
    setTimeout(() => { window.location.href = '/admin'; }, 1200);
  }
}

document.getElementById('save-btn').addEventListener('click',savePw);
document.addEventListener('keydown', e => { if (e.key === 'Enter' && linkOk) savePw(); });
</script>
</Layout>

<style>.err,.ok{margin-top:16px;font-size:14px}.ok{color:var(--success)}.forgot{display:block;min-height:44px;margin-top:12px;background:none;border:0;text-decoration:underline;font-size:14px}.btn{width:100%}</style>
