  const existing = new Set((data || []).map(a => (a.addon_name || '').toLowerCase()));
  const missing = STARTER_ADDONS
    .filter(a => !existing.has(a.addon_name.toLowerCase()))
    .map(a => ({ ...a, available: true }));
  if (!missing.length) { toast('Starter add-ons are already in the list'); return; }
  const { error } = await sb.from('addon_pricing').insert(missing);
  if (error) { toast('Could not add: ' + error.message); return; }
  await loadPricing(); toast(missing.length + ' add-ons added');
}
window.seedAddons = seedAddons;

async function deleteAddon(id) {
  if (!confirm('Delete this add-on? Clients will no longer see it.')) return;
  const { error } = await sb.from('addon_pricing').delete().eq('id', id);
  if (error) { toast('Could not delete: ' + error.message); return; }
  await loadPricing(); toast('Add-on deleted');
}
window.deleteAddon = deleteAddon;

function toggleSale(id, checked) {
  const saleInput = document.getElementById('pr-sale-'+id);
  if (saleInput) saleInput.disabled = !checked;
}
window.toggleSale = toggleSale;

async function savePkg(id) {
  const base  = parseFloat(document.getElementById('pr-base-'+id)?.value) || 0;
  const onSale = document.getElementById('pr-onsale-'+id)?.checked;
  const sale  = onSale ? parseFloat(document.getElementById('pr-sale-'+id)?.value) || null : null;
  const avail = document.getElementById('pr-avail-'+id)?.checked;
  await sb.from('package_pricing').update({ base_price:base, sale_price:sale, on_sale:onSale, available:avail }).eq('id', id);
  await loadPricing(); toast('Package saved');
}
window.savePkg = savePkg;

async function toggleAvail(id, checked, type) {
  const table = type === 'pkg' ? 'package_pricing' : 'addon_pricing';
  await sb.from(table).update({ available: checked }).eq('id', id);
  await loadPricing(); toast('Availability updated');
}
window.toggleAvail = toggleAvail;

// ── COUPONS ──
async function loadCoupons() {
  const { data } = await sb.from('coupons').select('*').order('created_at', { ascending: false });
  allCoupons = data || [];
  renderCoupons();
}

function onCouponTypeChange() {
  const type = document.getElementById('cp-type').value;
  const wrap  = document.getElementById('cp-value-wrap');
  const label = document.getElementById('cp-value-label');
  const input = document.getElementById('cp-value');
  if (type === 'travel') { wrap.style.display='none'; }
  else { wrap.style.display=''; label.textContent = type==='percent' ? 'Discount %' : 'Discount $'; input.placeholder = type==='percent' ? 'e.g. 20' : 'e.g. 15'; }
}
window.onCouponTypeChange = onCouponTypeChange;

async function createCoupon() {
  const code    = document.getElementById('cp-code').value.trim().toUpperCase();
  const type    = document.getElementById('cp-type').value;
  const value   = type !== 'travel' ? parseFloat(document.getElementById('cp-value').value) || 0 : null;
  const expires = document.getElementById('cp-expires').value || null;
  const maxUses = parseInt(document.getElementById('cp-max-uses').value) || null;
  if (!code) { toast('Enter a code'); return; }
  const { error } = await sb.from('coupons').insert({ code, type, value, expires_at: expires, max_uses: maxUses, uses: 0, active: true });
  if (error) { toast('Error: ' + error.message); return; }
  document.getElementById('cp-code').value = '';
  document.getElementById('cp-value').value = '';
  document.getElementById('cp-expires').value = '';
  document.getElementById('cp-max-uses').value = '';
  await loadCoupons(); toast('Coupon created');
}
window.createCoupon = createCoupon;

function renderCoupons() {
  const list = document.getElementById('coupon-list');
  if (!allCoupons.length) { list.innerHTML = '<p class="no-data">No coupons yet.</p>'; return; }
  const now = new Date();
  list.innerHTML = allCoupons.map(c => {
    const expired = c.expires_at && new Date(c.expires_at) < now;
    const maxed   = c.max_uses !== null && c.uses >= c.max_uses;
    const inactive = !c.active || expired || maxed;
    return `<div class="coupon-row${inactive?' inactive':''}">
      <div>
        <div class="coupon-info">
          <span class="coupon-code">${c.code}</span>
          <span class="coupon-badge ${c.type}">${c.type}</span>
          ${expired ? '<span class="coupon-badge expired">Expired</span>' : ''}
          ${!c.active ? '<span class="coupon-badge inactive-badge">Inactive</span>' : ''}
        </div>
        <div class="coupon-meta">
          ${c.type !== 'travel' ? (c.type==='percent' ? c.value+'% off' : '$'+c.value+' off') : 'Travel waived'}
          ${c.uses !== null ? ` · ${c.uses || 0}${c.max_uses ? '/' + c.max_uses : ''} uses` : ''}
          ${c.expires_at ? ` · expires ${c.expires_at}` : ''}
        </div>
      </div>
      <div class="coupon-actions">
        <button class="btn-sm" onclick="toggleCoupon('${c.id}',${c.active})">${c.active ? 'Deactivate' : 'Activate'}</button>
        <button class="btn-sm" onclick="copyCouponLink('${c.code}')">Copy link</button>
        <button class="btn-sm red" onclick="deleteCoupon('${c.id}')">Delete</button>
      </div>
    </div>`;
  }).join('');
}

async function toggleCoupon(id, active) {
  await sb.from('coupons').update({ active: !active }).eq('id', id);
  await loadCoupons(); toast(active ? 'Coupon deactivated' : 'Coupon activated');
}
window.toggleCoupon = toggleCoupon;

async function deleteCoupon(id) {
  if (!confirm('Delete this coupon?')) return;
  await sb.from('coupons').delete().eq('id', id);
  await loadCoupons(); toast('Coupon deleted');
}
window.deleteCoupon = deleteCoupon;

function copyCouponLink(code) {
  const link = window.location.origin + '/book?coupon=' + code;
  navigator.clipboard.writeText(link);
  toast('Link copied: ' + link);
}
window.copyCouponLink = copyCouponLink;

// ── ENVELOPE GENERATOR ──
const envCanvas = document.getElementById('env-canvas');
if (envCanvas) {
  const envCtx = envCanvas.getContext('2d');
  envCanvas.width  = 1800;
  envCanvas.height = 1200;

  function renderEnv() {
    const isDark  = document.getElementById('env-style')?.value === 'dark';
    const client  = document.getElementById('env-client')?.value || '';
    const msg     = document.getElementById('env-msg')?.value || '';
    const bg    = isDark ? '#1A1918' : '#F9F9F7';
    const ink   = isDark ? '#F9F9F7' : '#1A1918';
    const text2 = isDark ? '#9A9997' : '#6B6967';
    const text3 = isDark ? '#5A5957' : '#AEADA9';
    const bdr   = isDark ? '#2E2D2C' : '#E5E5E0';

    envCtx.clearRect(0,0,envCanvas.width,envCanvas.height);
    envCtx.fillStyle = bg; envCtx.fillRect(0,0,envCanvas.width,envCanvas.height);
    envCtx.strokeStyle = bdr; envCtx.lineWidth = 2; envCtx.strokeRect(1,1,envCanvas.width-2,envCanvas.height-2);
    envCtx.fillStyle = ink; envCtx.fillRect(0,0,8,envCanvas.height);

    envCtx.fillStyle = text3; envCtx.font = '600 28px sans-serif'; envCtx.letterSpacing='6px';
    envCtx.fillText('ZACHARY ROUTSONG PHOTOGRAPHY', 60, 75); envCtx.letterSpacing='0px';
    envCtx.fillStyle = bdr; envCtx.fillRect(60,95,envCanvas.width-120,1);

    if (client) { envCtx.fillStyle=text2; envCtx.font='300 36px sans-serif'; envCtx.fillText('For: '+client, 60, 185); }

    envCtx.fillStyle=text3; envCtx.font='400 28px monospace'; envCtx.letterSpacing='3px';
    envCtx.fillText('PRIVATE GALLERY', 60, client?280:240); envCtx.letterSpacing='0px';

    envCtx.fillStyle=ink; envCtx.font='300 120px sans-serif';
    envCtx.fillText('Your photos', 60, client?440:400);
    envCtx.fillText('are ready.', 60, client?580:540);

    if (msg) { envCtx.fillStyle=text2; envCtx.font='400 30px sans-serif'; envCtx.fillText(msg, 60, 700); }

    envCtx.fillStyle=bdr; envCtx.fillRect(60,1100,envCanvas.width-120,1);
    envCtx.fillStyle=text3; envCtx.font='400 26px monospace'; envCtx.letterSpacing='1px';
    envCtx.fillText('229-300-1006', 60, 1155); envCtx.letterSpacing='0px';
    envCtx.textAlign='right';
    envCtx.fillText('zacharyroutsongphotos', envCanvas.width-60, 1155);
    envCtx.textAlign='left';
  }
  window.renderEnv = renderEnv;

  function downloadEnv() {
    renderEnv();
    const a = document.createElement('a'); a.download='envelope.png'; a.href=envCanvas.toDataURL('image/png'); a.click();
  }
  window.downloadEnv = downloadEnv;
}
</script>
</Layout>
