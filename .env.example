# ── Build-time (Astro) — set locally in .env AND in Cloudflare Pages → Environment variables ──
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Runtime (Cloudflare Pages Functions) — set in the Cloudflare dashboard only ──
# All emails go through Resend (resend.com). Without RESEND_API_KEY, bookings
# still save to the admin panel but no emails are sent.
# RESEND_API_KEY=re_xxxxxxxx
# ZACHARY_EMAIL=you@example.com           # new-booking + confirmation notices land here
# SITE_URL=https://zrphotos.net           # used in email links
# FROM_EMAIL=bookings@zrphotos.net        # optional; MUST be a Resend-verified domain
#                                         # to email clients. Notices to your own
#                                         # ZACHARY_EMAIL work on the default sender.

# Photo storage — Cloudflare R2
# R2 bucket binding: Settings → Functions → R2 bucket bindings → PHOTOS → your bucket
# R2_BASE_URL=https://pub-xxxx.r2.dev
