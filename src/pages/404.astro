---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — Zachary Routsong Photography">
<style is:global>
.nf {
  min-height: calc(100vh - 260px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 72px 28px;
}
.nf-inner { max-width: 560px; text-align: center }
.nf-code {
  font-family: var(--font-sans);
  font-size: 12px;
  letter-spacing: .01em;
  color: var(--text-3);
  margin-bottom: 20px;
}
.nf h1 {
  font-size: clamp(36px, 7vw, 64px);
  font-weight: 320;
  letter-spacing: -.02em;
  line-height: 1.05;
  margin-bottom: 16px;
}
.nf h1 em { font-style: italic }
.nf p { font-size: 13px; color: var(--text-2); line-height: 1.8; margin-bottom: 28px }
</style>

<div class="nf">
  <div class="nf-inner">
    <p class="nf-code">404 — Not found</p>
    <h1>Lost the <em>shot.</em></h1>
    <p>This page doesn't exist — it may have moved, or the link has a typo.</p>
    <span><a href="/" class="btn">Back to home</a></span>
  </div>
</div>
</Layout>
