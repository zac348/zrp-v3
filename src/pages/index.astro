---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Zachary Routsong Photography">

<style is:global>
/* ── HERO ── */
.hero {
  padding: 96px 28px 72px;
  border-bottom: 1px solid var(--border);
}
.hero-inner { max-width: 1060px; margin: 0 auto }
.hero-kicker {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--text-3);
  margin-bottom: 26px;
}
.hero-name {
  font-family: var(--font-serif);
  font-weight: 320;
  font-size: clamp(52px, 11vw, 148px);
  line-height: .96;
  letter-spacing: -.03em;
  color: var(--text);
  margin: 0 0 36px;
}
.hero-name span { display: block }
.hero-name .indent { margin-left: clamp(24px, 9vw, 130px); font-style: italic }
.hero-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.hero-role {
  font-size: 14px;
  color: var(--text-2);
  line-height: 1.7;
  max-width: 380px;
}
.hero-role em { font-family: var(--font-serif); font-style: italic; color: var(--text); font-size: 15px }

/* ── SECTION SCAFFOLD ── */
.section { max-width: 1060px; margin: 0 auto; padding: 72px 28px }
.sec-head {
  display: flex;
  align-items: baseline;
  gap: 16px;
  margin-bottom: 36px;
}
.sec-num {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  color: var(--text-3);
  letter-spacing: .1em;
}
.sec-head h2 {
  font-size: 26px;
  color: var(--text);
  margin: 0;
}
.sec-head .rule { flex: 1; height: 1px; background: var(--border); align-self: center }

/* ── WORK / FILTER INDEX ── */
.work-index {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 22px;
  margin-bottom: 28px;
}
.cat-tag {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--text-3);
  background: none;
  border: none;
  padding: 0 0 3px;
  border-bottom: 1px solid transparent;
  cursor: pointer;
  transition: color .2s, border-color .2s;
  user-select: none;
}
.cat-tag:hover { color: var(--text) }
.cat-tag.active { color: var(--text); border-bottom-color: var(--accent) }
.cat-tag.disabled { opacity: .45; cursor: default; pointer-events: none }

/* ── MASONRY GRID ── */
.grid { columns: 3 260px; column-gap: 14px }
.grid-item {
  break-inside: avoid;
  margin-bottom: 14px;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  background: var(--surface-dim);
  opacity: 0;
  animation: scale-in .6s cubic-bezier(.16,1,.3,1) both;
  animation-delay: var(--d, 0s);
}
.grid-item img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform .6s cubic-bezier(.16,1,.3,1);
}
.grid-item:hover img { transform: scale(1.04) }
.grid-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(18,16,14,.6), rgba(18,16,14,0) 45%);
  opacity: 0;
  transition: opacity .3s;
  display: flex;
  align-items: flex-end;
  padding: 12px;
}
.grid-item:hover .grid-overlay { opacity: 1 }
.grid-overlay span {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgba(255,253,247,.9);
}
.placeholder-cell {
  break-inside: avoid;
  margin-bottom: 14px;
  aspect-ratio: 4/3;
  background: var(--surface-dim);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-cell span {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  color: var(--text-3);
}
.port-count {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: .08em;
  color: var(--text-3);
  margin-top: 18px;
}

/* ── FOLDER TABS ── */
.folder-tabs {
  display: flex;
  gap: 6px;
  position: relative;
  z-index: 2;
  margin-bottom: -1px;
  padding-left: 14px;
}
.folder-tab {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--text-3);
  background: var(--surface-dim);
  border: 1px solid var(--border);
  border-bottom: none;
  border-radius: 4px 4px 0 0;
  padding: 10px 20px 9px;
  cursor: pointer;
  transition: color .2s, background .2s;
}
.folder-tab:hover { color: var(--text) }
.folder-tab.active {
  background: var(--bg);
  color: var(--text);
}
.folder-panel {
  border: 1px solid var(--border);
  padding: 36px 32px;
  background: var(--bg);
}
@media (max-width: 600px) { .folder-panel { padding: 24px 18px } }

/* ── GEAR GRID ── */
.gear-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 12px;
}
.gear-card { background: var(--bg); border: 1px solid var(--border); padding: 22px 20px; transition: background .2s }
.gear-card:hover { background: var(--surface-dim) }
.gear-icon { width: 44px; height: 44px; color: var(--text-2); margin-bottom: 14px }
.gear-icon svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round }
.gear-name {
  font-family: var(--font-serif);
  font-size: 17px;
  color: var(--text);
  margin-bottom: 5px;
}
.gear-spec { font-size: 12px; color: var(--text-2); line-height: 1.6; margin-bottom: 10px }
.gear-uses {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-3);
  line-height: 1.8;
}
.gear-uses::before { content: 'used for — '; color: var(--accent) }

/* ── ABOUT ── */
.about-grid {
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 64px;
  align-items: start;
}
@media (max-width: 860px) { .about-grid { grid-template-columns: 1fr 1fr; gap: 36px } }
@media (max-width: 620px) { .about-grid { grid-template-columns: 1fr; gap: 32px } }

.about-photo {
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: cover;
  object-position: center top;
  display: block;
}

.about-lede {
  font-family: var(--font-serif);
  font-weight: 330;
  font-size: clamp(20px, 2.6vw, 27px);
  line-height: 1.45;
  letter-spacing: -.01em;
  color: var(--text);
  margin-bottom: 20px;
}
.about-lede em { font-style: italic }
.about-body {
  font-size: 13.5px;
  color: var(--text-2);
  line-height: 1.85;
  max-width: 480px;
  margin-bottom: 32px;
}

/* fact rows instead of stat boxes */
.facts { list-style: none; margin: 0 0 32px; padding: 0; max-width: 480px }
.facts li {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 11px 0;
  border-top: 1px solid var(--border);
}
.facts li:last-child { border-bottom: 1px solid var(--border) }
.facts .f-label {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--text-3);
}
.facts .f-value {
  font-family: var(--font-serif);
  font-size: 17px;
  color: var(--text);
}
</style>

<!-- HERO -->
<header class="hero">
  <div class="hero-inner">
    <p class="hero-kicker anim" style="--d:.05s">Photographer — Valdosta, Georgia</p>
    <h1 class="hero-name">
      <span class="anim" style="--d:.12s">Zachary</span>
      <span class="indent anim" style="--d:.22s">Routsong</span>
    </h1>
    <div class="hero-foot">
      <p class="hero-role anim" style="--d:.34s"><em>Portraits, families, events &amp; sports.</em><br/>Every session comes with a private online gallery, quick turnaround, and simple pricing.</p>
      <span class="anim" style="--d:.45s"><a href="/book" class="btn">Book a session</a></span>
    </div>
  </div>
</header>

<!-- WORK -->
<section class="section reveal" id="portfolio">
  <div class="sec-head">
    <span class="sec-num">01</span>
    <h2>Selected work</h2>
    <span class="rule"></span>
  </div>
  <div class="work-index" id="cat-tags">
    <button class="cat-tag disabled">Loading…</button>
  </div>
  <div class="grid" id="portfolio-grid">
    <div class="placeholder-cell"><span>Loading…</span></div>
    <div class="placeholder-cell"><span>Loading…</span></div>
    <div class="placeholder-cell"><span>Loading…</span></div>
  </div>
  <p class="port-count" id="port-count"></p>
</section>

<!-- ABOUT / GEAR -->
<section class="section reveal" id="about" style="border-top:1px solid var(--border)">
  <div class="sec-head">
    <span class="sec-num">02</span>
    <h2>About</h2>
    <span class="rule"></span>
  </div>

  <div class="folder-tabs" role="tablist">
    <button class="folder-tab active" id="ft-about" role="tab" onclick="showPanel('about')">About me</button>
    <button class="folder-tab" id="ft-gear" role="tab" onclick="showPanel('gear')">My gear</button>
  </div>

  <div class="folder-panel">
    <!-- ABOUT ME -->
    <div id="panel-about">
      <div class="about-grid">
        <img src="/zachary.jpg" alt="Zachary Routsong" class="about-photo"/>
        <div>
          <p class="about-lede">Based in Valdosta. I shoot a little bit of everything — the goal is photos that <em>look like the moment felt.</em></p>
          <p class="about-body">Portraits, families, events, and sports. Sharp, well-edited images, delivered through a private gallery within the week. No fluff, no upsells at the door.</p>
          <ul class="facts">
            <li><span class="f-label">Starting price</span><span class="f-value" id="stat-starting-price">$40</span></li>
            <li><span class="f-label">Turnaround</span><span class="f-value">5–7 days</span></li>
            <li><span class="f-label">Edited photos</span><span class="f-value">25+ per session</span></li>
            <li><span class="f-label">Coverage</span><span class="f-value">Valdosta &amp; nearby</span></li>
          </ul>
          <a href="/book" class="btn">Book a session</a>
        </div>
      </div>
    </div>

    <!-- MY GEAR -->
    <div id="panel-gear" style="display:none">
      <div class="gear-grid">

        <div class="gear-card">
          <div class="gear-icon"><svg viewBox="0 0 44 44"><rect x="5" y="14" width="34" height="21" rx="2"/><path d="M15 14l2.5-4h9l2.5 4"/><circle cx="22" cy="24.5" r="6.5"/><circle cx="22" cy="24.5" r="3"/><path d="M33 19h2.5"/></svg></div>
          <div class="gear-name">Sony A7 III</div>
          <p class="gear-spec">24MP full-frame mirrorless. Fast autofocus, strong in low light.</p>
          <p class="gear-uses">Every session</p>
        </div>

        <div class="gear-card">
          <div class="gear-icon"><svg viewBox="0 0 44 44"><circle cx="22" cy="22" r="14"/><circle cx="22" cy="22" r="8.5"/><circle cx="22" cy="22" r="3.5"/></svg></div>
          <div class="gear-name">Tamron 28–75mm f/2.8</div>
          <p class="gear-spec">Fast standard zoom — the everyday lens. Sharp wide open.</p>
          <p class="gear-uses">Portraits · Families · Events</p>
        </div>

        <div class="gear-card">
          <div class="gear-icon"><svg viewBox="0 0 44 44"><rect x="4" y="17" width="24" height="11" rx="1.5"/><path d="M28 15.5h8v14h-8"/><path d="M12 17v11M19 17v11"/></svg></div>
          <div class="gear-name">Sony 55–210mm</div>
          <p class="gear-spec">f/4.5–6.3 telephoto zoom. Reach for shots from the stands.</p>
          <p class="gear-uses">Sports · Candids at distance</p>
        </div>

        <div class="gear-card">
          <div class="gear-icon"><svg viewBox="0 0 44 44"><circle cx="10" cy="12" r="4.5"/><circle cx="34" cy="12" r="4.5"/><circle cx="10" cy="32" r="4.5"/><circle cx="34" cy="32" r="4.5"/><rect x="16" y="18" width="12" height="8" rx="2"/><path d="M13 15l4 4M31 15l-4 4M13 29l4-4M31 29l-4-4"/></svg></div>
          <div class="gear-name">DJI Mini 3</div>
          <p class="gear-spec">4K aerial camera, under 249g. Angles you can't get from the ground.</p>
          <p class="gear-uses">Aerials · Venues · Outdoor events</p>
        </div>

        <div class="gear-card">
          <div class="gear-icon"><svg viewBox="0 0 44 44"><rect x="15" y="7" width="13" height="17" rx="3.5"/><path d="M18 12h7M21.5 24v6c0 5 8 3 8 8"/><circle cx="29.5" cy="39" r="2"/></svg></div>
          <div class="gear-name">DJI Mic Mini</div>
          <p class="gear-spec">Ultra-light wireless mic. Clean audio without cables in the shot.</p>
          <p class="gear-uses">Interviews · Video add-ons</p>
        </div>

        <div class="gear-card">
          <div class="gear-icon"><svg viewBox="0 0 44 44"><rect x="14.5" y="5" width="15" height="34" rx="4.5"/><circle cx="22" cy="14" r="5.5"/><circle cx="22" cy="14" r="2"/><path d="M18 31h8"/></svg></div>
          <div class="gear-name">Insta360</div>
          <p class="gear-spec">360° capture with the invisible-stick effect. Angles that follow the action.</p>
          <p class="gear-uses">Action cams · Behind the scenes</p>
        </div>

        <div class="gear-card">
          <div class="gear-icon"><svg viewBox="0 0 44 44"><rect x="5.5" y="17" width="14" height="11" rx="5"/><rect x="24.5" y="17" width="14" height="11" rx="5"/><path d="M19.5 20.5c1.5-1.5 3.5-1.5 5 0M5.5 19.5L2.5 17M38.5 19.5l3-2.5"/><circle cx="9" cy="20" r="1.2"/></svg></div>
          <div class="gear-name">Meta Ray-Bans</div>
          <p class="gear-spec">Hands-free POV camera built into glasses.</p>
          <p class="gear-uses">POV clips · Behind the scenes</p>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- LIGHTBOX -->
<div class="lightbox" id="lb" onclick="closeLB()">
  <button class="lb-close" onclick="closeLB()">×</button>
  <img id="lb-img" src="" alt=""/>
</div>

<script>
import { createClient } from '@supabase/supabase-js';

const sb = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

let allPhotos = [], activeCat = null;

async function loadPortfolio() {
  const { data, error } = await sb
    .from('portfolio_photos')
    .select('*')
    .eq('show_on_homepage', true)
    .order('created_at', { ascending: false });

  if (error || !data || !data.length) {
    // No photos yet — hide the whole section instead of showing empty boxes
    document.getElementById('portfolio').style.display = 'none';
    return;
  }

  allPhotos = data;

  // Category counts (the `sport` column doubles as the photo's category)
  const catCounts = {};
  data.forEach(p => { if (p.sport) catCounts[p.sport] = (catCounts[p.sport] || 0) + 1; });
  const cats = Object.keys(catCounts).sort();

  const tagsEl = document.getElementById('cat-tags');
  if (!cats.length) {
    tagsEl.innerHTML = '<button class="cat-tag disabled">No tagged photos yet</button>';
  } else {
    tagsEl.innerHTML =
      '<button class="cat-tag active" id="tag-all" onclick="filterCat(null)">All</button>' +
      cats.map(c =>
        `<button class="cat-tag" onclick="filterCat('${c}')">${c} <span style="opacity:.55">(${catCounts[c]})</span></button>`
      ).join('');
  }

  filterCat(null);
}

function filterCat(cat) {
  activeCat = cat;
  const photos = cat ? allPhotos.filter(p => p.sport === cat) : allPhotos;
  renderGrid(photos);
  document.getElementById('port-count').textContent =
    photos.length + ' photograph' + (photos.length !== 1 ? 's' : '') + (cat ? ' — ' + cat : '');
  document.querySelectorAll('.cat-tag').forEach(t => {
    const label = t.textContent.trim();
    t.classList.toggle('active', cat ? label.startsWith(cat) : t.id === 'tag-all');
  });
}
window.filterCat = filterCat;

function renderGrid(photos) {
  const g = document.getElementById('portfolio-grid');
  if (!photos.length) {
    g.innerHTML = '<div class="placeholder-cell" style="aspect-ratio:auto;padding:48px"><span>No photos in this category yet</span></div>';
    return;
  }
  g.innerHTML = '';
  photos.forEach((p, i) => {
    const el = document.createElement('div');
    el.className = 'grid-item';
    el.style.setProperty('--d', (Math.min(i, 8) * 0.06) + 's');
    el.innerHTML = `<img src="${p.url}" alt="${p.sport || ''}" loading="lazy"/>
      <div class="grid-overlay"><span>${p.sport || ''}</span></div>`;
    el.addEventListener('click', () => openLB(p.url));
    g.appendChild(el);
  });
}

function openLB(url) {
  document.getElementById('lb-img').src = url;
  document.getElementById('lb').classList.add('open');
}
window.openLB = openLB;

function closeLB() {
  document.getElementById('lb').classList.remove('open');
}
window.closeLB = closeLB;

document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLB(); });

// ── ABOUT / GEAR FOLDER TABS ──
function showPanel(which) {
  document.getElementById('panel-about').style.display = which === 'about' ? 'block' : 'none';
  document.getElementById('panel-gear').style.display  = which === 'gear'  ? 'block' : 'none';
  document.getElementById('ft-about').classList.toggle('active', which === 'about');
  document.getElementById('ft-gear').classList.toggle('active', which === 'gear');
}
window.showPanel = showPanel;

async function loadStartingPrice() {
  try {
    const { data } = await sb.from('package_pricing').select('base_price, sale_price, on_sale').eq('available', true);
    if (!data?.length) return;
    const lowest = Math.min(...data.map(p => (p.on_sale && p.sale_price) ? p.sale_price : p.base_price));
    if (isFinite(lowest)) {
      document.getElementById('stat-starting-price').textContent = '$' + lowest;
    }
  } catch(e) {}
}

loadPortfolio();
loadStartingPrice();
</script>
</Layout>
