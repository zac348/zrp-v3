---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Portfolio — Zachary Routsong Photography"
  description="Full portfolio — portraits, families, events, sports, and landscapes. Valdosta, Georgia."
>

<style is:global>
/* Page header only — section scaffold, filter index, and masonry grid come from global.css */
.port-head { max-width: 1060px; margin: 0 auto; padding: 72px 28px 0 }
.port-title {
  font-size: clamp(32px, 6vw, 56px);
  font-weight: 320;
  letter-spacing: -.025em;
  line-height: 1.05;
  margin: 0 0 12px;
}
.port-lede {
  font-size: 13.5px;
  color: var(--text-2);
  line-height: 1.8;
  max-width: 440px;
}
.load-more-wrap { display: flex; justify-content: center; margin-top: 36px }
@media (max-width: 700px) { .port-head { padding: 48px 18px 0 } }
</style>

<header class="port-head">
  <h1 class="port-title">Portfolio</h1>
  <p class="port-lede">Everything, by category. Click a photo to open it.</p>
</header>

<section class="section" id="portfolio" style="padding-top:40px">
  <div class="sec-head">
    <span class="sec-num" id="port-total">—</span>
    <h2>All work</h2>
    <span class="rule"></span>
  </div>

  <div class="work-index" id="cat-tags">
    <button class="cat-tag disabled">Loading…</button>
  </div>

  <div class="grid" id="portfolio-grid">
    <div class="placeholder-cell"><span>Loading…</span></div>
    <div class="placeholder-cell"><span>Loading…</span></div>
    <div class="placeholder-cell"><span>Loading…</span></div>
  </div>

  <p class="port-count" id="port-count"></p>

  <div class="load-more-wrap" id="load-more-wrap" style="display:none">
    <button class="btn" id="load-more" onclick="loadMore()">Load more</button>
  </div>
</section>

<!-- LIGHTBOX -->
<div class="lightbox" id="lb" role="dialog" aria-modal="true" aria-label="Photo">
  <button class="lb-close" type="button" aria-label="Close">×</button>
  <img id="lb-img" src="" alt=""/>
</div>

<script>
import { createClient } from '@supabase/supabase-js';
import { makeTile, bindLightbox } from '../lib/gallery.js';

const sb = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const BATCH = 24;                       // render in chunks so a big archive stays fast
let allPhotos = [], filtered = [], shown = 0, activeCat = null;

async function loadPortfolio() {
  const { data } = await sb
    .from('portfolio_photos')
    .select('url, web_url, thumb_url, width, height, sport, title, location')
    .eq('on_portfolio', true)
    .order('created_at', { ascending: false })
    .limit(500);

  allPhotos = data || [];

  if (!allPhotos.length) {
    document.getElementById('cat-tags').style.display = 'none';
    document.getElementById('portfolio-grid').innerHTML =
      '<div class="placeholder-cell" style="aspect-ratio:auto;padding:56px"><span>No photos here yet</span></div>';
    document.getElementById('port-total').textContent = '00';
    return;
  }

  document.getElementById('port-total').textContent =
    String(allPhotos.length).padStart(2, '0');

  // Same category source as the homepage — the `sport` column is the category
  const catCounts = {};
  allPhotos.forEach(p => { if (p.sport) catCounts[p.sport] = (catCounts[p.sport] || 0) + 1; });
  const cats = Object.keys(catCounts).sort();

  const tagsEl = document.getElementById('cat-tags');
  if (!cats.length) {
    tagsEl.style.display = 'none';
  } else {
    tagsEl.innerHTML =
      `<button class="cat-tag active" id="tag-all" onclick="filterCat(null, true)">All <span style="opacity:.55">(${allPhotos.length})</span></button>` +
      cats.map(c =>
        `<button class="cat-tag" onclick="filterCat('${c}', true)">${c} <span style="opacity:.55">(${catCounts[c]})</span></button>`
      ).join('');
  }

  const wanted = new URLSearchParams(location.search).get('cat');
  filterCat(cats.includes(wanted) ? wanted : null);
}

function filterCat(cat, fromUser = false) {
  activeCat = cat;
  filtered = cat ? allPhotos.filter(p => p.sport === cat) : allPhotos;
  shown = 0;
  document.getElementById('portfolio-grid').innerHTML = '';

  if (!filtered.length) {
    document.getElementById('portfolio-grid').innerHTML =
      '<div class="placeholder-cell" style="aspect-ratio:auto;padding:48px"><span>No photos in this category yet</span></div>';
  } else {
    appendBatch();
  }

  document.querySelectorAll('.cat-tag').forEach(t => {
    const label = t.textContent.trim();
    t.classList.toggle('active', cat ? label.startsWith(cat) : t.id === 'tag-all');
  });
  // Only move the page when someone picked a filter — never on first load
  if (fromUser) window.scrollTo({ top: document.getElementById('portfolio').offsetTop - 80, behavior: 'smooth' });
}
window.filterCat = filterCat;

function appendBatch() {
  const g = document.getElementById('portfolio-grid');
  const next = filtered.slice(shown, shown + BATCH);

  g.append(...next.map((p, i) => makeTile(p, shown + i, 3)));

  shown += next.length;
  updateMeta();
}

function loadMore() { appendBatch(); }
window.loadMore = loadMore;

function updateMeta() {
  const label = activeCat ? ' — ' + activeCat : '';
  document.getElementById('port-count').textContent =
    shown < filtered.length
      ? `Showing ${shown} of ${filtered.length} photographs${label}`
      : `${filtered.length} photograph${filtered.length !== 1 ? 's' : ''}${label}`;
  document.getElementById('load-more-wrap').style.display =
    shown < filtered.length ? 'flex' : 'none';
}

bindLightbox();

loadPortfolio();
</script>
</Layout>
